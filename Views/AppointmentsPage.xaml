<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"
    xmlns:viewmodels="using:LiteClinic.ViewModels"   
    d:DataContext="{d:DesignInstance Type=viewmodels:AppointmentsViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d" 
    Background="#f1f1f1">


    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFontItalic}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFontItalic}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>



        <services:TimeFormatterConverter x:Key="TimeFormatterConverter"/>
        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="AppointmetnPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="AppointmetnPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F3" Invoked="AppointmetnPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="AppointmetnPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>

        <!-- Main content -->

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="20, 15, 20,15" Spacing="7">

                    <!--
                    <TextBlock Text="Patient's ID" />
                    <TextBox Text="{Binding PatientAutoId}" IsReadOnly="True" Width="190" />-->

                    <TextBlock x:Uid="AppP_PatientNameLabel" Text="Patient's Name" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    <TextBox Text="{Binding PatientName}" IsReadOnly="True" Width="190" Background="LightSkyBlue"/>

                    <TextBlock x:Uid="AppP_DateOfBirthLabel" Text="Date of Birth" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    <TextBox Text="{Binding DateOfBirth}" IsReadOnly="True" Width="190" Background="LightSkyBlue"/>

                    <TextBlock x:Uid="AppP_AppointmentDateLabel" Text="Appointment Date" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>

                    <CalendarDatePicker x:Uid="AppP_AppointmentDatePicker"
                        Date="{Binding AppointmentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Select appointment date" Width="200"
                        x:Name="CalendarDatePickerAppointment"
                        GettingFocus="CalendarDatePickerAppointment_GettingFocus"
                        LosingFocus="CalendarDatePickerAppointment_LosingFocus"/>

                    <TextBlock x:Uid="AppP_DoctorNameLabel" Text="Doctor Name" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    <ComboBox x:Uid="AppP_DoctorComboBox"
                              ItemsSource="{Binding DoctorList}" 
                              SelectedItem="{Binding SelectedDoctorListforAppoitnment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              DisplayMemberPath="FullNameWithSpecialty"
                              Width="250"
                              x:Name="DoctorListAppointment"
                              LostFocus="DoctorListAppointment_LostFocus"/>

                    <TextBlock x:Uid="AppP_AppointmentTimeLabel" Text="Appointment Time" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    <ComboBox x:Uid="AppP_TimeComboBox" 
                              ItemsSource="{Binding TimeSlots}" 
                              SelectedItem="{Binding AppointmentTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Width="150"
                              GettingFocus="ComboBox_GettingFocus"
                              LostFocus="ComboBox_LostFocus"
                              x:Name="TimeStampAppointment">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TimeFormatterConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Uid="AppP_AppointmentTypeLabel" Text="Appointment Type" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    
                    <ComboBox x:Uid="AppP_AppointmentTypeComboBox" 
                              ItemsSource="{Binding AppointmentTypes}"
                              SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="150"/>

                    <TextBlock x:Uid="AppP_NotesLabel" Text="Notes" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" 
                             Height="60" 
                             x:Name="NotesAppointment"
                             GettingFocus="NotesAppointment_GettingFocus"
                             LostFocus="NotesAppointment_LostFocus"
                             FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>

                    <StackPanel>
                        <CheckBox x:Uid="AppP_IsActiveCheckBox"
                                  Content="Is Active" Margin="0,2" 
                                  IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel>
                        <CheckBox x:Uid="AppP_IsMissedCheckBox" 
                                  Content="Mark as missed" Margin="0,2" 
                                  IsChecked="{Binding IsMIssed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTipService.ToolTip="Check if the patient missed this appointment"
                                  FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Visibility="Collapsed"/>
                    </StackPanel>




                    <!-- Operation Button -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Submit Button -->
                        <Button x:Uid="AppP_AddButton"
                                Content="Add"  
                                Margin="10" 
                                Background="Teal" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanAddAppoitment}"
                                Command="{Binding Btn_SaveCommand}"
                                ToolTipService.ToolTip="Save New Appoitnment"
                                FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                        <Button x:Uid="AppP_EditButton"
                                Content="Edit"
                                Margin="10" 
                                Background="RoyalBlue" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditAppoitment}"
                                Command="{Binding Btn_UpdateCommand}"
                                ToolTipService.ToolTip="Update Appoitnment"
                                FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Submit Button -->
                        <Button x:Uid="AppP_DeactivateButton"
                                Content="Deactivate" 
                                Margin="10" 
                                Background="Red" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditAppoitment}"
                                Command="{Binding Btn_DeactivateCommand}"
                                ToolTipService.ToolTip="Deactivate Appoitnment"
                                FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                        <Button x:Uid="AppP_ClearButton"
                                Content="Clear"  
                                Margin="10" 
                                Background="LightGray" 
                                Foreground="Black" 
                                Width="90"
                                Command="{Binding Btn_ClearCommand}"
                                ToolTipService.ToolTip="Clear data (refresh)"
                                FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Rectangle Width="16" Height="16" Fill="#FF87cefa" Stroke="#FF808080" Margin="0,0,5,0"/>
                        <TextBlock x:Uid="AppP_ReadOnlyLabel" Text="Read Only Fields" FontSize="14" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>
                    </StackPanel>


                </StackPanel>


            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Border Width="1" Background="Gray" Margin="5"/>
            </StackPanel>

            <Grid Grid.Column="2">

                <TabView>
                    <TabViewItem Header="Patients" FontWeight="Bold">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Patients ListView -->

                            <StackPanel Orientation="Horizontal" Spacing="5" Grid.Row="0">
                                <TextBlock x:Uid="AppP_SearchPatientListLabel"
                                       Text=" Search Patient List" 
                                       HorizontalAlignment="Left" 
                                       Margin="10"
                                       FontFamily="{StaticResource CurrentAppFont}" 
                                       FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Uid="AppP_SearchPatientBox" 
                                     PlaceholderText="Search Patient" 
                                     Width="200" 
                                     HorizontalAlignment="Right"
                                     Margin="10"
                                     Text="{Binding SearchQueryPatient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListView Grid.Row="1" 
                                      x:Name="ListViewPatientInAppointment"
                                      Margin="10"
                                      SelectionMode="Single"
                                      ItemsSource="{Binding PatientsList}"
                                      SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                      DoubleTapped="ListView_DoubleTappedPatient"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <!-- Column headers -->
                                <ListView.Header>
                                    <Grid ColumnDefinitions="100,200,220,220,220,150,150,150,150" 
                                              Background="LightGray" Height="35">
                                        <TextBlock Text="Auto" Grid.Column="0"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Patient Code" Grid.Column="1"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Full Name" Grid.Column="2"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="First Name" Grid.Column="3"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Middle Name" Grid.Column="4"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Last Name" Grid.Column="5"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Mother's Name" Grid.Column="6"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="DOB" Grid.Column="7"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Age" Grid.Column="8"
                                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                                    </Grid>
                                </ListView.Header>

                                <!-- Row template -->
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="100,200,220,220,220,150,150,150,150" Height="40">
                                            <!-- Auto -->
                                            <TextBlock Text="{Binding PatientAutoId}"
                                                           Grid.Column="0"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Patient Code -->
                                            <TextBlock Text="{Binding PatientId, Mode=TwoWay}"
                                                           Grid.Column="1"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Full Name -->
                                            <TextBlock Text="{Binding PatientFullName, Mode=TwoWay}"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- First Name -->
                                            <TextBlock Text="{Binding FirstName, Mode=TwoWay}"
                                                           Grid.Column="3"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Middle Name -->
                                            <TextBlock Text="{Binding MiddleName, Mode=TwoWay}"
                                                           Grid.Column="4"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Last Name -->
                                            <TextBlock Text="{Binding LastName, Mode=TwoWay}"
                                                           Grid.Column="5"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Mother's Name -->
                                            <TextBlock Text="{Binding FullMotherName, Mode=TwoWay}"
                                                           Grid.Column="6"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Date of Birth -->
                                            <TextBlock Text="{Binding DateOfBirth, Mode=TwoWay}"
                                                           Grid.Column="7"
                                                           Style="{StaticResource CustomCellStyle}"/>

                                            <!-- Age -->
                                            <TextBlock Text="{Binding PatientAge, Mode=TwoWay}"
                                                           Grid.Column="8"
                                                           Style="{StaticResource CustomCellStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Appointments" FontWeight="Bold">
                        <!-- Appointments ListView -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <StackPanel Orientation="Vertical" Spacing="5" Grid.Row="0">

                                <!-- Appointment List Label -->
                                <TextBlock x:Uid="AppP_AppointmentListLabel" 
                                           Text="Appointment List"
                                           Margin="10"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Height="30"
                                           HorizontalAlignment="Left"/>


                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">

                                    <!-- Doctor Filter ComboBox -->
                                    <ComboBox x:Uid="AppP_DoctorFilterComboBox"
                                              Width="180"
                                              Margin="10"
                                              ItemsSource="{Binding DoctorListForSearch}"
                                              SelectedItem="{Binding SelectedDoctorListforSearch, Mode=TwoWay}"
                                              DisplayMemberPath="FullNameWithSpecialty"
                                              PlaceholderText="Filter by Doctor"
                                              FontFamily="{StaticResource CurrentAppFontItalic}"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Left"
                                              x:Name="DrAppoitnemtForSearch"/>

                                    <!-- Today's Appointments Toggle -->
                                    <CheckBox x:Uid="AppP_TodayAppointmentsCheckBox"
                                              Margin="10"
                                              Content="Today's Appointments"
                                              IsChecked="{Binding IsTodayFilterEnabled, Mode=TwoWay}"
                                              FontFamily="{StaticResource CurrentAppFontItalic}"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Left"/>

                                    <!-- Search Box -->
                                    <TextBox x:Uid="AppP_SearchAppointmentBox"
                                             Width="150"
                                             Margin="10"
                                             PlaceholderText="Search Appointment"
                                             Text="{Binding SearchQueryAppointment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14"
                                             Height="30"
                                             HorizontalAlignment="Left"/>

                                </StackPanel>
                            </StackPanel>


                                <ListView x:Name="ListViewAppointment"
                                          Grid.Row="4"
                                          Margin="10"
                                          SelectionMode="Single"
                                          ItemsSource="{Binding DisplayedScheduledAppointmentsList}"
                                          SelectedItem="{Binding SelectedScheduledAppointmentDisplay, Mode=TwoWay}"
                                          DoubleTapped="ListView_DoubleTappedAppointment"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollMode="Enabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <!-- Column headers -->
                                    <ListView.Header>
                                        <Grid ColumnDefinitions="200,130,130,200,150,150,100,100,200,150,250,150,150,150,150"
                                              Background="LightGray" Height="35">
                                            <TextBlock Text="Patient Name" Grid.Column="0" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Date" Grid.Column="1" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Time" Grid.Column="2" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Dr. Name" Grid.Column="3" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Specialization" Grid.Column="4" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Appointment Type" Grid.Column="5" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Dr. ID" Grid.Column="6" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Auto" Grid.Column="7" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Appointment ID" Grid.Column="8" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Patient ID" Grid.Column="9" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="Mother's Name" Grid.Column="10" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                            <TextBlock Text="DOB" Grid.Column="11" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Is Active" Grid.Column="12" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        <TextBlock Text="Status" Grid.Column="13" Style="{StaticResource CustomColumnHeaderStyle}"/>
                                        </Grid>
                                    </ListView.Header>

                                    <!-- Row template -->
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="220,130,130,200,150,150,100,100,200,150,250,150,150,150" Height="50">
                                                <!-- Patient Name -->
                                                <TextBlock Text="{Binding PatientName, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="0" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Date -->
                                                <TextBlock Text="{Binding AppointmentDateFormatted, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="1" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Time -->
                                                <TextBlock Text="{Binding AppointmentTimeFormatted, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="2" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Doctor Name -->
                                                <TextBlock Text="{Binding DoctorName, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="3" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Specialty -->
                                                <TextBlock Text="{Binding Specialty, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="4" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Appointment Type -->
                                                <TextBlock Text="{Binding AppointmentType, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="5" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Doctor ID -->
                                                <TextBlock Text="{Binding DoctorId, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="6" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Schedule ID -->
                                                <TextBlock Text="{Binding ScheduleId}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="7" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Appointment ID -->
                                                <TextBlock Text="{Binding AppointmentID, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="8" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Patient ID -->
                                                <TextBlock Text="{Binding PatientId, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="9" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Mother's Name -->
                                                <TextBlock Text="{Binding PatientMotherName, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="10" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- DOB -->
                                                <TextBlock Text="{Binding PatientDOBFormatted, Mode=TwoWay}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                           Grid.Column="11" Style="{StaticResource CustomCellStyle}"/>

                                                <!-- Is Active -->
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                          Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                                          Margin="25,0,0,0"
                                                          Grid.Column="12"/>


                                                <!-- Status -->
                                                <TextBlock Text="{Binding AttendStatus}"
                                                           Margin="25,0,0,0"
                                                           Grid.Column="13" Style="{StaticResource CustomCellStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                        </Grid>

                    </TabViewItem>
                </TabView>


            </Grid>
            
        </Grid>

        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>

    </Grid>
</Page>
