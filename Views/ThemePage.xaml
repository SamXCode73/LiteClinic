<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:models="using:LiteClinic.Models"
    xmlns:services="using:LiteClinic.Services"    
    d:DataContext="{d:DesignInstance Type=viewmodels:ThemePageViewModel, IsDesignTimeCreatable=True}"        
    mc:Ignorable="d">


    <Page.Resources>
        <services:ThemeTypeToColorConverter x:Key="ThemeTypeToColorConverter"/>
    </Page.Resources>

    <Grid>
        <!-- Column 0: Theme Selection -->
        <StackPanel Margin="20" Spacing="10" HorizontalAlignment="Center">
            <TextBlock x:Uid="Stp_ThemeSelectionTitle"
                                   Text="Theme Selection"
                                   FontSize="18"
                                   FontFamily="{StaticResource CurrentAppFont}"
                                   FontWeight="Bold"
                                   Margin="20"/>

            <!-- ComboBox Themes -->
            <Border BorderBrush="#CCC" BorderThickness="3" CornerRadius="3" Padding="10">
                <ComboBox x:Uid="Stp_ThemeSelectionComboBox"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="16" Height="16" 
                                                 Fill="{Binding Converter={StaticResource ThemeTypeToColorConverter}}" 
                                                 Margin="0,0,8,0"
                                                 Stroke="Silver"
                                                 StrokeThickness="2"/>
                                <TextBlock x:Uid="Stp_ThemeSelectionItemText"
                                                   Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
        </StackPanel>


    </Grid>
</Page>
