<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:models="using:LiteClinic.Models"
    d:DataContext="{d:DesignInstance Type=viewmodels:BackupPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Grid>

        <!-- Backup -->
        <StackPanel Margin="20" HorizontalAlignment="Center">
            <TextBlock x:Uid="Stp_BackupTitle"
                       Text="Backup"
                       FontSize="18"
                       FontFamily="{StaticResource CurrentAppFont}"
                       FontWeight="Bold"
                       Margin="20"/>
            <Border BorderBrush="#CCC" BorderThickness="3" CornerRadius="3" Padding="10">
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBox x:Uid="Stp_BackupLocationTextBox"
                         Width="250"
                         Text="{Binding BackupLocation, Mode=TwoWay}"
                         PlaceholderText="Select backup folder"
                         IsReadOnly="True"/>

                    <Button x:Uid="Stp_BrowseBackupButton"
                        Content="Browse..."
                        Margin="15,0,0,0"
                        Background="RoyalBlue"
                        Foreground="AntiqueWhite"
                        FontFamily="{StaticResource CurrentAppFont}"
                        FontWeight="Bold"
                        IsEnabled="{Binding CanManageSettingsMenu}"
                        Command="{Binding BrowseBackupFolderCommand}"
                        Width="100"/>
                </StackPanel>
            </Border>
            <Button x:Uid="Stp_BackupDatabaseButton"
                    Content="Backup Database"
                    Width="200"
                    Margin="10"
                    Background="Teal"
                    Foreground="AntiqueWhite"
                    FontFamily="{StaticResource CurrentAppFont}"
                    FontWeight="Bold"
                    IsEnabled="{Binding CanViewSettingsMenu}"
                    Command="{Binding BackupDatabaseCommand}"/>
        </StackPanel>

    </Grid>
</Page>
