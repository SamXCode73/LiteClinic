<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:local="using:LiteClinic.Views"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"   
    d:DataContext="{d:DesignInstance Type=viewmodels:MainPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              Background="#f1f1f1"
              HorizontalAlignment="Center"
              Height="32">
        </Grid>




        <!-- Header -->
        <Grid Grid.Row="1" Background="{ThemeResource TopBarBackgroundBrush}" x:Name="TopBar">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="10,0,10,0">
                <Image Width="24" Height="24"
                       x:Name="AppIcon"
                       Margin="5,4,5,4"
                       Source="/Assets/icon/app_icon_24x24.png"/>
                <TextBlock x:Uid="AppTitle"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="5, 10, 10, 10"
                           Foreground="{ThemeResource TopBarForegroundBrush}"
                           FontFamily="{StaticResource CurrentAppFont}"
                           x:Name="MainTitile"
                           FontSize="24"/>
            </StackPanel>

            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="10, 10, 45,10"
                       Foreground="{ThemeResource TopBarForegroundBrush}"
                       FontFamily="{StaticResource CurrentAppFont}"                      
                       x:Name="SubTitile"
                       FontSize="20"/>

            <Image Width="30" Height="30" 
                   x:Name="LoadingSpinner"
                   Margin="10, 10, 10, 10"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Visibility="Collapsed">

                <Image.RenderTransform>
                    <RotateTransform x:Name="LoadingSpinnerRotateTransform" CenterX="15" CenterY="15"/>
                </Image.RenderTransform>
            </Image>


        </Grid>

        <!-- Main Layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EnglishSidebarColumn" Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- English Sidebar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Background="{ThemeResource SideBarBackgroundBrush}"
                            Padding="7"
                            Spacing="20"
                            VerticalAlignment="Stretch"
                            x:Name="SideBar">
                    <Border Background="Transparent"
                            CornerRadius="6"
                            BorderThickness="0.00001"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Height="30"
                                   Tapped="HamburgerMenu_Tapped"
                                   x:Uid="HamburgerMenu"
                                    ToolTipService.ToolTip="Toggle Menu"
                                    Margin="5,0,0,0"
                                   x:Name="HamburgerMenu"/>
                        </StackPanel>
                    </Border>



                    <!-- ###### Menu Items ####### -->

                    <!-- Dashboard Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            x:Name="DashboardBorder"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="6"
                            Tapped="DashboardMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="DashboardShakeTransform" />
                            </StackPanel.RenderTransform>


                            <Image Width="24" Height="24"
                                   Tapped="DashboardMenu_Tapped" 
                                   x:Name="DashboardMenu"
                                   x:Uid="Mm_DashboardMenu"
                                   ToolTipService.ToolTip="Dashboard"/>

                            <TextBlock x:Uid="DashboardMenu"
                                       x:Name="HomeLabel" 
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}" 
                                       Style="{StaticResource MyMenuTextStyleNormal}"
                                       FontFamily="{StaticResource CurrentAppFont}"
                                       Tapped="DashboardMenu_Tapped"/>

                        </StackPanel>
                    </Border>


                    <!-- Doctors Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="DoctorsMenu_Tapped">

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="DoctorsShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="DoctorsMenu_Tapped"
                                   x:Name="DoctorsMenu"
                                   x:Uid="Mm_DoctorsMenu"
                                   ToolTipService.ToolTip="Doctors"/>
                            <TextBlock x:Uid="DoctorsMenu"
                               x:Name="DoctorsLabel"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource MenuLabelForegroundBrush}"
                               Style="{StaticResource MyMenuTextStyleNormal}"
                               FontFamily="{StaticResource CurrentAppFont}"
                               Tapped="DoctorsMenu_Tapped" />

                        </StackPanel>
                    </Border>

                    <!-- Patients Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="PatientsMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PatientsShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="PatientsMenu_Tapped"
                                   x:Name="PatientsMenu"
                                   x:Uid="Mm_PatientsMenu"
                                   ToolTipService.ToolTip="Patients"/>
                            <TextBlock x:Uid="Patients"
                               x:Name="PatientsLabel"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource MenuLabelForegroundBrush}"
                               Style="{StaticResource MyMenuTextStyleNormal}"
                               FontFamily="{StaticResource CurrentAppFont}"
                               Tapped="PatientsMenu_Tapped" />
                        </StackPanel>
                    </Border>

                    <!-- Appointments Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            Visibility="{Binding CanAccesssAppMenu}"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="AppointmentsMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="AppointmentsShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="AppointmentsMenu_Tapped"
                                   x:Name="AppointmentsMenu"
                                   x:Uid="Mm_AppointmentsMenu"
                                   ToolTipService.ToolTip="Appointments"/>
                            <TextBlock x:Uid="Appointments"
                                   x:Name="AppointmentsLabel" 
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                   Style="{StaticResource MyMenuTextStyleNormal}"
                                   FontFamily="{StaticResource CurrentAppFont}"
                                   Tapped="AppointmentsMenu_Tapped" />
                        </StackPanel>
                    </Border>

                    <!-- Reports Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            Visibility="{Binding CanAccessMenu}"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="ReportsMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="ReportsShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="ReportsMenu_Tapped"
                                   x:Name="ReportsMenu"
                                   x:Uid="Mm_ReportsMenu"
                                   ToolTipService.ToolTip="Reports"/>
                            <TextBlock x:Uid="Reports"
                               x:Name="ReportsLabel" 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource MenuLabelForegroundBrush}"
                               Style="{StaticResource MyMenuTextStyleNormal}"
                               FontFamily="{StaticResource CurrentAppFont}"
                               Tapped="ReportsMenu_Tapped"/>
                        </StackPanel>
                    </Border>


                    <!-- Users Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="UsersMenu_Tapped"
                            Visibility="{Binding CanAccessMenu}">

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="UsersShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="UsersMenu_Tapped"
                                   x:Name="UsersMenu"
                                   x:Uid="Mm_UsersMenu"
                                   ToolTipService.ToolTip="Users"/>
                            <TextBlock x:Uid="Users"
                               x:Name="UsersLabel" 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource MenuLabelForegroundBrush}"
                               Style="{StaticResource MyMenuTextStyleNormal}"
                               FontFamily="{StaticResource CurrentAppFont}"
                               Tapped="UsersMenu_Tapped"/>
                        </StackPanel>
                    </Border>


                    <!-- Settings Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            Visibility="{Binding CanViewSettingsMenu}"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="SettingsMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="SettingsShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   Tapped="SettingsMenu_Tapped"
                                   x:Name="SettingsMenu"
                                   x:Uid="Mm_SettingsMenu"
                                   ToolTipService.ToolTip="Settings"/>
                            <TextBlock x:Uid="Settings"
                                       x:Name="SettingsLabel" 
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                       Style="{StaticResource MyMenuTextStyleNormal}"
                                       FontFamily="{StaticResource CurrentAppFont}"
                                       Tapped="SettingsMenu_Tapped"/>
                        </StackPanel>
                    </Border>

                    <!-- About Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="AboutMenu_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="AboutShakeTransform" />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   x:Name="AboutMenu"
                                   x:Uid="Mm_AboutMenu"
                                   ToolTipService.ToolTip="About"/>
                            <TextBlock x:Uid="About"
                                       x:Name="AboutLabel" 
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                       Style="{StaticResource MyMenuTextStyleNormal}"
                                       FontFamily="{StaticResource CurrentAppFont}"
                                       />
                        </StackPanel>
                    </Border>


                    <!-- Logout Menu Item -->
                    <Border Background="Transparent"
                            PointerEntered="Border_PointerEntered"
                            PointerExited="Border_PointerExited"
                            BorderBrush="{StaticResource MenuLabelForegroundBrush}"
                            CornerRadius="4"
                            Tapped="Tapped_LogOut">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform />
                            </StackPanel.RenderTransform>

                            <Image Width="24" Height="24"
                                   x:Name="LogoutMenu"
                                   x:Uid="Mm_LogoutMenu"
                                   ToolTipService.ToolTip="Logout"/>
                            <TextBlock x:Uid="Logout"
                                       x:Name="LogoutLabel" 
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                       Style="{StaticResource MyMenuTextStyleNormal}"
                                       FontFamily="{StaticResource CurrentAppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- ###### Botom Menu ####### -->

                </StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Bottom" Background="{ThemeResource SideBarBackgroundBrush}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" 
                                Padding="10,10,10,10"
                                Height="40">

                            <TextBlock x:Uid="Mpg_LoggedUserLabel" 
                                       Text="Logged user:" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                       FontFamily="{StaticResource CurrentAppFontItalic}"
                                       Margin="7,0,0,0"/>
                            <TextBlock Text="{Binding LoggedUserName}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{ThemeResource MenuLabelForegroundBrush}"
                                       FontFamily="{StaticResource CurrentAppFontItalic}"
                                       Margin="7,0,0,0"/>

                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>


            <!-- Main Content with Navigation Frame -->
            <Grid Grid.Column="1" Background="#f1f1f1">
                <Frame x:Name="ContentFrame">
                </Frame>
            </Grid>

        </Grid>
    </Grid>
</Page>