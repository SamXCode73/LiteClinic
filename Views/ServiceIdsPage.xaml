<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.ServiceIdsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"
    xmlns:models="using:LiteClinic.Models"   
    xmlns:viewmodels="using:LiteClinic.ViewModels" 
    d:DataContext="{d:DesignInstance Type=viewmodels:ServiceIdsPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">

    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="ServiceIdsPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="ServiceIdsPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>

        <!-- Main content -->

        <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Uid="SIDp_SelectMessagingPlatformPatients"
                       Text="Select Messaging Platform - Patients"
                       FontFamily="{StaticResource CurrentAppFont}"
                       FontSize="24"/>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Patient Section-->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>



                    <Border Grid.Row="0"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="LightGray"
                            Margin="10"
                            Width="400">

                        <StackPanel Margin="10" Spacing="12">

                            <!-- Section Title -->
                            <TextBlock x:Uid="SIDp_AddServiceTitle"
                                       Text="Add Service"
                                       Margin="10"
                                       FontFamily="{StaticResource CurrentAppFont}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>

                            <!-- PatientId -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="SIDp_PatientIdLabel"
                                           Text="Patient ID:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>
                                
                                <TextBox x:Name="PatientIdTextBox"
                                         Width="200"
                                         x:Uid="SIDp_PatientIdTextBox"
                                         PlaceholderText="Enter Patient ID"
                                         Text="{Binding PatientAutoId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>

                            <!-- PatientIdText -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="SIDp_PatientCodeLabel"
                                           Text="Patient Code/Text:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>

                                <TextBox x:Uid="SIDp_PatientCodeTextBox"
                                         x:Name="PatientIdTextTextBox"
                                         Width="200"
                                         PlaceholderText="Enter Patient Code"
                                         Text="{Binding PatientIdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>

                            <!-- ServiceName (enum ProviderType) Patient -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="SIDp_ServiceNameLabel"
                                           Text="Service Name:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>

                                <ComboBox x:Uid="SIDp_ServiceNameComboBox"
                                          x:Name="ServiceNameComboBox"
                                          Width="200"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding SelectedPatientService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <!-- Bind to enum later, for now static -->
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameTelegram" Content="Telegram" Tag="0" FontWeight="Bold"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameWhatsApp" Content="WhatsApp" Tag="1" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameDiscord" Content="Discord" Tag="2" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameEmail" Content="Email" Tag="3" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameSms" Content="Sms" Tag="4" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameSlack" Content="Slack" Tag="5" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameViber" Content="Viber" Tag="6" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameTeams" Content="MicrosoftTeams" Tag="7" IsEnabled="False"/>
                                    <ComboBoxItem x:Uid="SIDp_ServiceNameMessenger" Content="FacebookMessenger" Tag="8" IsEnabled="False"/>
                                    <!-- etc. -->
                                </ComboBox>
                            </StackPanel>

                            <!-- ServiceId -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="SIDp_ServiceIdLabel"
                                           Text="Service ID:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>

                                <TextBox x:Uid="SIDp_ServiceIdTextBox"
                                         x:Name="ServiceIdTextBox"
                                         Width="200"
                                         PlaceholderText="Enter Chat ID / Number"
                                         Text="{Binding PatientServiceBase.ServiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- IsActive -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="SIDp_IsActiveLabel"
                                           Text="Is Active:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>

                                <CheckBox x:Uid="SIDp_IsActiveCheckBox" 
                                          x:Name="IsActiveCheckBox" 
                                          IsChecked="{Binding PatientServiceBase.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Notification Language-->

                            </StackPanel>
                            <Border BorderThickness="1"
                                    BorderBrush="Gray" 
                                    Margin="10" 
                                    Padding="10" 
                                    MaxWidth="350" 
                                    HorizontalAlignment="Left"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock x:Uid="SIDp_SendNotificationLabel"
                                               Text="Send Notification with"
                                               Margin="10, 5, 5, 15"
                                               FontFamily="{StaticResource CurrentAppFont}"
                                               FontWeight="Bold"/>

                                    <!-- English option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock x:Uid="SIDp_NotifyEnglishLabel"
                                                   Text="English" Width="130"
                                                   FontFamily="{StaticResource CurrentAppFont}"
                                                   FontWeight="Bold"/>

                                        <CheckBox x:Uid="SIDp_NotifyEnglishCheckBox"
                                                  x:Name="EnNotification"
                                                  IsChecked="{Binding PatientServiceBase.NotifyEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- French option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock x:Uid="SIDp_NotifyFrenchLabel"
                                                   Text="French" Width="130"
                                                   FontFamily="{StaticResource CurrentAppFont}"
                                                   FontWeight="Bold"/>

                                        <CheckBox x:Uid="SIDp_NotifyEnglishCheckBox"
                                                  x:Name="FrNotification"
                                                  IsChecked="{Binding PatientServiceBase.NotifyFr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>                                    
                                    <!-- Arabic option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock x:Uid="SIDp_NotifyArabicLabel"
                                                   Text="Arabic" Width="130"
                                                   FontFamily="{StaticResource CurrentAppFont}"
                                                   FontWeight="Bold"/>
                                        
                                        <CheckBox x:Uid="SIDp_NotifyArabicCheckBox"
                                                  x:Name="ArNotification"
                                                  IsChecked="{Binding PatientServiceBase.NotifyAr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Save Button -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">

                                <Button x:Uid="SIDp_ApplyPatientServiceButton"
                                        Content="Apply Patient Service"
                                        Width="200"
                                        HorizontalAlignment="Center"
                                        Margin="10"
                                        Background="Teal"
                                        Foreground="AntiqueWhite"
                                        Command="{Binding Btn_ApplyPatientCommand}"
                                        IsEnabled="{Binding CanEditChatId}"
                                        ToolTipService.ToolTip="Save/Update - F1"
                                        ToolTipService.Placement="Bottom"
                                        FontFamily="{StaticResource CurrentAppFont}"
                                        FontWeight="Bold"/>

                                <Button x:Uid="SIDp_ClearButton"
                                        Content="Clear"
                                        Width="70"
                                        HorizontalAlignment="Center"
                                        Margin="10"
                                        Background="Gray"
                                        Foreground="AntiqueWhite"
                                        Command="{Binding Btn_ClearPatientCommand}"
                                        ToolTipService.ToolTip="Clear Fields - F4"
                                        ToolTipService.Placement="Bottom"
                                        FontFamily="{StaticResource CurrentAppFont}"
                                        FontWeight="Bold"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">


                            </StackPanel>
                        </StackPanel>
                    </Border>


                </Grid>
            </ScrollViewer>


            <!-- Patients DataGrid (manages its own scrollbars) -->

            <Grid Grid.Column="1" Height="Auto" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- for search box -->
                    <RowDefinition Height="*"/>
                    <!-- for DataGrid -->
                </Grid.RowDefinitions>


                <TextBox x:Uid="SIDp_SearchBox"
                         Grid.Row="0" Text="{Binding PatientFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250"
                         Height="30"
                         PlaceholderText="Search  Service/Patient Id"
                         Margin="0,0,0,15"/>
                <!-- Patients Service Page ListView -->
                <ListView x:Name="ListViewPatientServices"
          Grid.Row="1"
          Margin="0,0,0,15"
          Padding="0"
          SelectionMode="Single"
          ItemsSource="{Binding PatientServicesDisplay}"
          SelectedItem="{Binding SelectedPatientServiceIdsDisplay, Mode=TwoWay}"
          DoubleTapped="PatientListView_DoubleTapped"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Enabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          HorizontalContentAlignment="Left">

                    <!-- Column headers -->
                    <ListView.Header>
                        <Grid ColumnDefinitions="120,150,150,200,150,100,100,100,100"
              Background="LightGray" Height="30">
                            <TextBlock Text="Service ID Auto" Grid.Column="0" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Patient ID" Grid.Column="1" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Code" Grid.Column="2" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Service Name" Grid.Column="3" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Service ID" Grid.Column="4" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Active" Grid.Column="5" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Notify En" Grid.Column="6" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Notify Fr" Grid.Column="7" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Notify Ar" Grid.Column="8" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        </Grid>
                    </ListView.Header>

                    <!-- Row template -->
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PatientServiceIdsDisplay">
                            <Grid ColumnDefinitions="120,150,150,200,150,100,100,100,100" Height="30">
                                <!-- Service ID Auto -->
                                <TextBlock Text="{Binding PatientServiceId}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontStyle="Italic" FontWeight="SemiBold"
                                           Grid.Column="0" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Patient ID -->
                                <TextBlock Text="{Binding PatientAutoId}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontStyle="Italic" FontWeight="SemiBold"
                                           Grid.Column="1" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Code -->
                                <TextBlock Text="{Binding PatientId}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontStyle="Italic" FontWeight="SemiBold"
                                           Grid.Column="2" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Service Name -->
                                <TextBlock Text="{Binding ServiceName}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontStyle="Italic" FontWeight="SemiBold"
                                           Grid.Column="3" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Service ID -->
                                <TextBlock Text="{Binding ServiceId}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontStyle="Italic" FontWeight="SemiBold"
                                           Grid.Column="4" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Active -->
                                <CheckBox IsChecked="{Binding IsActive}"
                                          Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic" FontWeight="SemiBold"
                                          Grid.Column="5"/>

                                <!-- Notify En -->
                                <CheckBox IsChecked="{Binding NotifyEn}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic" FontWeight="SemiBold"
                                          Grid.Column="6"/>

                                <!-- Notify Fr -->
                                <CheckBox IsChecked="{Binding NotifyFr}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic" FontWeight="SemiBold"
                                          Grid.Column="7"/>

                                <!-- Notify Ar -->
                                <CheckBox IsChecked="{Binding NotifyAr}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic" FontWeight="SemiBold"
                                          Grid.Column="8"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>


            </Grid>
        </Grid>


        <!-- Info bar -->
        <Border Grid.Row="2"
                Background="#dcdcdc"
                Padding="10">

            <!-- Date and infor bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>

    </Grid>
</Page>