<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.DrServiceIdsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"
    xmlns:models="using:LiteClinic.Models"   
    xmlns:viewmodels="using:LiteClinic.ViewModels" 
    d:DataContext="{d:DesignInstance Type=viewmodels:DrServiceIdsPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">

    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>

    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="DrServiceIdsPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="DrServiceIdsPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>

        <!-- Main content -->

        <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Uid="DrSp_PageTitle"
                       FontFamily="{StaticResource CurrentAppFont}"
                       FontSize="24"/>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>



            <!-- Doctor Section-->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="LightGray"
                            Margin="10"
                            Width="400">

                        <StackPanel Margin="10" Spacing="12">

                            <!-- Section Title -->
                            <TextBlock x:Uid="DrSp_AddServiceTitle" 
                                       Text="Add Service"
                                       Margin="10"
                                       FontFamily="{StaticResource CurrentAppFont}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>   

                            <!-- DoctorId -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DrSp_DoctorIdLabel"
                                           Text="Doctor ID:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>
                                <TextBox x:Uid="DrSp_DoctorIdTextBox"
                                         x:Name="DoctorIdTextBox"
                                         Width="200"
                                         PlaceholderText="Enter Doctor ID"
                                         Text="{Binding DoctorIdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         FontFamily="{StaticResource CurrentAppFont}"/>
                            </StackPanel>

                            <!-- DoctorCode -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DrSp_DoctorCodeLabel" 
                                           Text="Doctor Code:" 
                                           Width="120"
                                           FontWeight="Bold"/>

                                <TextBox x:Uid="DrSp_DoctorCodeTextBox" 
                                         x:Name="DoctorCodeTextBox"
                                         Width="200"
                                         PlaceholderText="Enter Doctor Code"
                                         Text="{Binding DoctorCodeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         FontFamily="{StaticResource CurrentAppFont}"/>
                            </StackPanel>

                            <!-- ServiceName (enum ProviderType) for doctors-->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DrSp_ServiceNameLabel" 
                                           Text="Service Name:" 
                                           Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>

                                <ComboBox x:Name="DoctorServiceNameComboBox"
                                          Width="200"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding SelectedDoctorService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="{StaticResource CurrentAppFont}">
                                    
                                    <!-- Bind to enum later, for now static -->
                                    <ComboBoxItem Content="Telegram" Tag="0"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="WhatsApp" Tag="1" IsEnabled="False" 
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="Discord" Tag="2" IsEnabled="False"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="Email" Tag="3" IsEnabled="False" 
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="Sms" Tag="4" IsEnabled="False" 
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="Slack" Tag="5" IsEnabled="False"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="Viber" Tag="6" IsEnabled="False"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="MicrosoftTeams" Tag="7" IsEnabled="False"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <ComboBoxItem Content="FacebookMessenger" Tag="8" IsEnabled="False"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    <!-- etc. -->
                                </ComboBox>
                            </StackPanel>

                            <!-- ServiceId -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DrSp_ServiceIdLabel" 
                                           Text="Service ID:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>
                                
                                <TextBox x:Uid="DrSp_ServiceIdTextBox" 
                                         x:Name="DoctorServiceIdTextBox"
                                         Width="200"
                                         PlaceholderText="Enter Chat ID / Number"
                                         Text="{Binding DoctorServiceBase.ServiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource CurrentAppFont}"/>
                            </StackPanel>

                            <!-- IsActive -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DrSp_IsActiveLabel" 
                                           Text="Is Active:" Width="120"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontWeight="Bold"/>
                                
                                <CheckBox x:Name="DoctorIsActiveCheckBox" 
                                          IsChecked="{Binding DoctorServiceBase.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="{StaticResource CurrentAppFont}"/>

                            </StackPanel>

                            <!-- Notification Language-->
                            <Border BorderThickness="1"
                                    BorderBrush="Gray" 
                                    Margin="10" 
                                    Padding="10" 
                                    MaxWidth="350" 
                                    HorizontalAlignment="Left"
                                    CornerRadius="5">

                                <StackPanel>
                                    <TextBlock x:Uid="DrSp_NotificationTitle" 
                                               Text="Send Notification with"
                                               Margin="10, 5, 5, 10"
                                               FontFamily="{StaticResource CurrentAppFont}"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                    <!-- English option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">

                                        <TextBlock x:Uid="DrSp_NotificationEnglishLabel" 
                                                   Text="English" Width="130"
                                                   FontWeight="Bold"/>

                                        <CheckBox x:Uid="DrSp_NotificationEnglishCheckBox" 
                                                  x:Name="EnNotification"
                                                  IsChecked="{Binding DoctorServiceBase.NotifyEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    </StackPanel>

                                    <!-- English option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">

                                        <TextBlock x:Uid="DrSp_NotificationFrenchLabel" 
                                                   Text="French" Width="130"
                                                   FontWeight="Bold"/>

                                        <CheckBox x:Uid="DrSp_NotificationFrenchCheckBox" 
                                                  x:Name="FrNotification"
                                                  IsChecked="{Binding DoctorServiceBase.NotifyFr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    </StackPanel>

                                    <!-- Arabic option -->
                                    <StackPanel Orientation="Horizontal" Spacing="5">

                                        <TextBlock x:Uid="DrSp_NotificationArabicLabel" 
                                                   Text="Arabic" Width="130"
                                                   FontFamily="{StaticResource CurrentAppFont}"
                                                   FontWeight="Bold"/>

                                        <CheckBox x:Uid="DrSp_NotificationArabicCheckBox" 
                                                  x:Name="ArNotification"
                                                  IsChecked="{Binding DoctorServiceBase.NotifyAr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FontFamily="{StaticResource CurrentAppFont}"/>
                                    </StackPanel>
                                </StackPanel>

                            </Border>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                
                                <!-- Save Button -->
                                <Button x:Uid="DrSp_ApplyDoctorServiceButton" 
                                        Content="Apply Doctor Service"
                                        Width="200"
                                        HorizontalAlignment="Center"
                                        Margin="10"
                                        Background="Teal"
                                        Foreground="AntiqueWhite"
                                        Command="{Binding Btn_ApplydoctorCommand}"
                                        IsEnabled="{Binding CanEditDrChatId}"
                                        ToolTipService.ToolTip="Save/Update - F1"
                                        FontFamily="{StaticResource CurrentAppFont}"
                                        FontWeight="Bold"
                                        MaxHeight="37"/>


                                <Button x:Uid="DrSp_ClearButton" 
                                        Content="Clear"
                                        Width="70"
                                        HorizontalAlignment="Center"
                                        Margin="10"
                                        Background="Gray"
                                        Foreground="AntiqueWhite"
                                        Command="{Binding Btn_ClearDoctorCommand}"
                                        ToolTipService.ToolTip="Clear Fields - F4"
                                        ToolTipService.Placement="Bottom"
                                        FontFamily="{StaticResource CurrentAppFont}"
                                        FontWeight="Bold"
                                        MaxHeight="37"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>




                </Grid>
            </ScrollViewer>
            
            <!-- Doctors DataGrid (manages its own scrollbars) -->
            <Grid Grid.Column="1" Height="Auto" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- for search box -->
                    <RowDefinition Height="*"/>
                    <!-- for DataGrid -->
                </Grid.RowDefinitions>
                
                <TextBox Grid.Row="0"
                         Text="{Binding DoctorFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="250"
                         Height="30"
                         x:Uid="DrSp_SearchBox"                         
                         PlaceholderText="Search Service/Doctor Id" 
                         Margin="0,0,0,15"
                         FontFamily="{StaticResource CurrentAppFont}"/>


                <!-- Doctor Servie ListView -->
                <ListView x:Name="ListViewDoctorServices"
                          Grid.Row="1"
                          Margin="5"
                          SelectionMode="Single"
                          ItemsSource="{Binding DoctorServicesDisplay}"
                          SelectedItem="{Binding SelectedDoctorServiceIdsDisplay, Mode=TwoWay}"
                          DoubleTapped="ListView_DoubleTapped"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Left">

                    <!-- Column headers -->
                    <ListView.Header>
                        <Grid ColumnDefinitions="120,120,120,120,120,120,120,120,120,120"
                              Background="LightGray" Height="30">
                            <TextBlock Text="Service ID Auto" Grid.Column="0" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Doctor ID" Grid.Column="1" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Code" Grid.Column="2" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Service Name" Grid.Column="3" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Service ID" Grid.Column="4" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Active" Grid.Column="5" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="En Notify" Grid.Column="6" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Fr Notify" Grid.Column="7" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Ar Notify" Grid.Column="8" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        </Grid>
                    </ListView.Header>

                    <!-- Row template -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="120,120,120,120,120,120,120,120,120" Height="40">
                                <!-- Service ID Auto -->
                                <TextBlock Text="{Binding DoctorServiceId}"
                                           FontStyle="Italic"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           Grid.Column="0" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Doctor ID -->
                                <TextBlock Text="{Binding DoctorAutoId}"
                                           FontStyle="Italic"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           Grid.Column="1" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Code -->
                                <TextBlock Text="{Binding DoctorCodeText}"
                                           FontStyle="Italic"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           Grid.Column="2" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Service Name -->
                                <TextBlock Text="{Binding ServiceName}"
                                           FontStyle="Italic"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           Grid.Column="3" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Service ID -->
                                <TextBlock Text="{Binding ServiceId}"
                                           FontStyle="Italic"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           Grid.Column="4" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Active -->
                                <CheckBox IsChecked="{Binding IsActive}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic"
                                          FontWeight="SemiBold"
                                          FontFamily="{StaticResource CurrentAppFont}"
                                          Grid.Column="5"/>

                                <!-- En Notify -->
                                <CheckBox IsChecked="{Binding NotifyEn}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic"
                                          FontWeight="SemiBold"
                                          FontFamily="{StaticResource CurrentAppFont}"
                                          Grid.Column="6"/>

                                <!-- Fr Notify -->
                                <CheckBox IsChecked="{Binding NotifyFr}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic"
                                          FontWeight="SemiBold"
                                          FontFamily="{StaticResource CurrentAppFont}"
                                          Grid.Column="7"/>

                                <!-- Ar Notify -->
                                <CheckBox IsChecked="{Binding NotifyAr}"
                                          Margin="25,0,0,0"
                                          FontStyle="Italic"
                                          FontWeight="SemiBold"
                                          FontFamily="{StaticResource CurrentAppFont}"
                                          Grid.Column="8"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>


        <!-- Info bar -->
        <Border Grid.Row="2"
                Background="#dcdcdc"
                Padding="10">

            <!-- Date and infor bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource EnglishFont}"                        
                           Style="{StaticResource TextBlockFont}"
                           Foreground="Gray"
                           x:Name="RomanDateText"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"                        
                           Style="{StaticResource TextBlockDateAr}"
                           FontSize="14"
                           Foreground="Gray"
                           x:Name="HijriDateText"/>
            </Grid>
        </Border>

    </Grid>
</Page>
