<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.DoctorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:DoctorsViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"    
    Background="#f1f1f1">


    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="Padding" Value="3"/>
        </Style>



        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <services:ProfilePictureConverter x:Key="ProfilePictureConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F3" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="UserPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>

        <!-- Define two rows: main content and bottom info bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>


        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>
            <!-- Main Content-->
            
            <ScrollViewer Grid.Row="0" Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          Padding="5"
                          Margin="5">
                <StackPanel Spacing="10" Margin="5">
                    <!-- Basic Info -->
                    <TextBlock x:Uid="DrP_DoctorsControl"
                               x:Name="DoctorsControl" 
                               Text="Doctor Control manager" 
                               FontSize="16" FontFamily="{StaticResource CurrentAppFont}" 
                               FontWeight="Bold"/>



                    <!-- Profile Picture Section -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!--profile picture -->
                        <PersonPicture ProfilePicture="{Binding ProfilePicturePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                            Converter={StaticResource ProfilePictureConverter}}"
                                       Width="120" Height="120"
                                       BorderBrush="Gray"
                                       BorderThickness="1"
                                       CacheMode="BitmapCache"
                                       Initials="{Binding Initials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Edit icon button -->
                        <Button x:Uid="DrP_AddimageforDoctor"
                                Width="40" Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-5,-5" 
                                Background="#FF4169E1"   
                                Foreground="#FFFFFFFF"                            
                                BorderThickness="1"
                                CornerRadius="50"
                                ToolTipService.ToolTip="Addc - Change picture. Only .PNG or .JPG"
                                Command="{Binding Btn_BrowsPicture}">
                            <Button.Resources>
                                <!-- Hover state -->
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF5A7BE1"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>

                                <!-- Pressed state -->
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF27408B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            </Button.Resources>
                            <FontIcon Glyph="&#xE104;"
                                      FontFamily="Segoe MDL2 Assets"
                                      Foreground="White"
                                      FontSize="14" />
                        </Button>
                    </Grid>


                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Uid="DrP_DoctorFullName" 
                                 Header="Doctor's Name" 
                                 x:Name="DoctorFullName"
                                 Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Doctor's full name"
                                 MinWidth="220"
                                 FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"/>

                        <Ellipse Width="7" Height="7" Fill="#FFFF0000" HorizontalAlignment="Right" Margin="10, 25, 10, 0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Uid="DrP_SpecializationBox"
                                 Header="Specialization" 
                                 x:Name="SpecializationBox"
                                 Text="{Binding Specialization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220"
                                 FontFamily="{StaticResource CurrentAppFont}"/>

                        <Ellipse Width="7" Height="7" Fill="#FFFF0000" HorizontalAlignment="Right" Margin="10, 25, 0, 0"/>
                    </StackPanel>

                    <!-- Gender -->
                    <StackPanel>
                        <ComboBox x:Uid="DrP_DoctorGender" 
                                  PlaceholderText="Selct Gender" 
                                  Header="Gender"                                  
                                  Width="120" 
                                  SelectedValue="{Binding Gender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem x:Uid="DrP_GenderMale" Content="Female"/>
                            <ComboBoxItem x:Uid="Drp_GenderFemal" Content="Male"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Uid="DrP_PhoneBox"
                                 Header="Phone Number" 
                                 x:Name="PhoneBox"
                                 Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220"
                                 FontFamily="{StaticResource CurrentAppFont}"/>

                        <Ellipse Width="7" Height="7" Fill="#FFFF0000" HorizontalAlignment="Right" Margin="10, 25, 0, 0"/>
                    </StackPanel>
                    <TextBox x:Uid="DrP_LandLineBox"
                             Header="Landline Number" 
                             x:Name="LandLineBox"
                             Text="{Binding LandLineNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="220"
                             HorizontalAlignment="Left"
                             FontFamily="{StaticResource CurrentAppFont}"/>

                    <StackPanel>
                        <CheckBox x:Uid="DrP_IsActiveCheckBox"
                                  Content="Is Active" Margin="0,2" IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontFamily="{StaticResource CurrentAppFont}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        
                        <!-- Submit Buttons -->
                        <Button x:Uid="DrP_AddButton"
                                Content="Add"  
                                Margin="10" 
                                Background="Teal" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanAddDoctor}"
                                Command="{Binding Btn_SaveDcotorCommand}"
                                ToolTipService.ToolTip="Save New Doctor/F1"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>
                        
                        <Button x:Uid="DrP_EditButton"
                                Content="Edit"  
                                Margin="10" 
                                Background="RoyalBlue" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditDoctor}"
                                Command="{Binding Btn_UpdateDcotorCommand}"
                                ToolTipService.ToolTip="Update Doctor/F2"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">

                        <!-- Deactivate Button -->
                        <Button x:Uid="DrP_DeactivateButton"
                                Content="Deactivate" 
                                Margin="10" 
                                Background="Red" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanDeactivateDoctor}"
                                Command="{Binding Btn_DeactivateDoctorCommadn}"
                                ToolTipService.ToolTip="Deactivate Doctro/F3"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>
                        
                        <Button x:Uid="DrP_ClearButton"
                                Content="Clear"  
                                Margin="10" 
                                Background="LightGray" 
                                Foreground="Black" 
                                Width="90"
                                Command="{Binding Btn_ClearCommand}"
                                ToolTipService.ToolTip="Clear Datat (refresh)/F4"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Add you code here -->
                        <Ellipse Width="10" Height="10" Fill="#FFFF0000" Stroke="Gray" Margin="0,0,5,0"/>
                        <TextBlock x:Uid="DrP_RequiredFieldsNote"
                                   Text="Required fields are marked with a red circle" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Width="220"/>
                    </StackPanel>





                </StackPanel>

            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Border Width="1" Background="Gray" Margin="5"/>

            </StackPanel>
            <!-- Title and Data Grid -->
            <!-- Title -->
            <Grid Column="1" HorizontalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0" Margin="20" HorizontalAlignment="Center">
                    <!-- Changed Fill color to dark orange -->
                    <Ellipse Width="15" Height="15" Fill="#FFFFBF00" Stroke="Gray" Margin="0,0,5,0"/>
                    <TextBlock x:Uid="DrP_ImportantNote" 
                               Text="IMPORTANT: After adding a doctor, go to the Open Scheduled Page to set the doctor’s schedule. This page shows which days of the month the doctor will attend." 
                               FontSize="14" 
                               TextWrapping="Wrap"
                               Foreground="IndianRed"
                               FontFamily="{StaticResource CurrentAppFont}"
                               FontWeight="Bold"
                               Width="600"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Uid="DrP_DoctorsManagerList"
                               Grid.Column="0"
                               Text="Doctors Manager List"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource CurrentAppFont}"
                               FontWeight="Bold"                               
                               FontSize="16"
                               Margin="15, 10, 5, 10"/>

                    <TextBox Grid.Column="1" x:Uid="DrP_SearchBox"
                             PlaceholderText="Search"
                             Width="250"
                             HorizontalAlignment="Center"
                             Margin="10, 0, 10, 0"                             
                             Height="10"
                             Text="{Binding DoctorFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="Search: ID, Code, Name, Phone, specialization"
                             ToolTipService.Placement="Top"
                             FontFamily="{StaticResource CurrentAppFont}"/>

                    <StackPanel Grid.Column="2" Spacing="5">
                        <Button x:Uid="DrP_OpenScheduledPageButton"
                                Content="Open Schdeled Page"
                                Margin="5, 5, 20, 5"
                                Background="Teal"
                                Foreground="White" 
                                HorizontalAlignment="Right"
                                Command="{Binding Btn_OpenScheduledPage}"
                                Width="180"
                                ToolTipService.ToolTip="Scheduled Page shows which days of the month the doctor will attend."
                                IsEnabled="{Binding CanAddDoctor}"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>

                        <Button Grid.Column="2" x:Uid="DrP_AddServiceButton"
                                Content="Add Service"
                                HorizontalAlignment="Right"
                                Background="RoyalBlue"
                                Foreground="AntiqueWhite"
                                Margin="0,0,20,0"
                                Width="180"
                                Command="{Binding Btn_GotoServicePage}"
                                IsEnabled="{Binding CanEditDoctor}"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"/>
                    </StackPanel>

                </Grid>

                <ListView Grid.Row="2" 
                              Margin="15" 
                              SelectionMode="Single"
                              ItemsSource="{Binding DisplayDoctorList}"
                              SelectedItem="{Binding SelectedDisplayDoctor, Mode=TwoWay}"
                              DoubleTapped="ListView_DoubleTapped"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- Column headers -->
                    <ListView.Header>
                        <Grid ColumnDefinitions="110,120,100,220,220,150,150,150"
                                  Background="LightGray" Height="35">
                            <TextBlock Text="Auto" Grid.Column="0"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Dr. ID" Grid.Column="1"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Photo" Grid.Column="2"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Full Name" Grid.Column="3"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Specialization" Grid.Column="4"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Mobile Phone" Grid.Column="5"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Land Line Phone" Grid.Column="6"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Active" Grid.Column="7"
                                       Style="{StaticResource CustomColumnHeaderStyle}"/>
                        </Grid>
                    </ListView.Header>

                    <!-- Row template -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="110,120,100,220,220,150,150,150" Height="50">
                                <!-- Auto -->
                                <TextBlock Text="{Binding DoctorId}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="0"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Dr. ID -->
                                <TextBlock Text="{Binding DoctorCode, Mode=TwoWay}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="1"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Photo -->
                                <Ellipse Width="40" Height="40" Grid.Column="2"
                                         Stroke="Gray" StrokeThickness="1"
                                         HorizontalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage UriSource="{Binding ProfilePicturePath, Mode=TwoWay, Converter={StaticResource ProfilePictureConverter}}"
                                                             CreateOptions="IgnoreImageCache"/>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Full Name -->
                                <TextBlock Text="{Binding FullName, Mode=TwoWay}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="3"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Specialization -->
                                <TextBlock Text="{Binding Specialization, Mode=TwoWay}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="4"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Mobile Phone -->
                                <TextBlock Text="{Binding PhoneNumber, Mode=TwoWay}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="5"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Land Line Phone -->
                                <TextBlock Text="{Binding LandLineNumber, Mode=TwoWay}"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="6"
                                           Style="{StaticResource CustomCellStyle}"/>

                                <!-- Active -->
                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Content="Active"
                                          Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                          HorizontalAlignment="Center"
                                          Margin="20,0,0,0"
                                          Grid.Column="7"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>


            </Grid>

        </Grid>



        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"          
                           Foreground="Gray"
                           x:Name="RomanDateText"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                   Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource TextBlockFontItalic}"
                   Foreground="{Binding StatusColor}"
                   x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                   Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource ArabicFont}"                        
                   Style="{StaticResource TextBlockDateAr}"
                   FontSize="14"
                   Foreground="Gray"
                   x:Name="HijriDateText"/>
            </Grid>
        </Border>
    </Grid>
</Page>
