<Page
    x:Class="LiteClinic.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LiteClinic.Models"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:services="using:LiteClinic.Services"
    d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">


    <Page.Resources>
        <services:BoolToVisibilityConverterForCheckBox x:Key="BoolToVisibilityConverterForCheckBox"/>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <services:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Page.Resources>

    <Grid>
        <!-- Define two rows: main content and bottom info bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>
        
        <!-- Main content -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <!-- Left column: e.g., doctor list -->
                <ColumnDefinition Width="2*" />
                <!-- Right column: e.g., appointments -->
            </Grid.ColumnDefinitions>

            <!-- Left Column Content -->

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Scrollable content -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Db_ClinicCalendarLabel" 
                               Grid.Column="0" Text="Clinic Calendar"
                               FontSize="18"
                               FontWeight="Bold"
                               FontFamily="{StaticResource CurrentAppFont}"
                               HorizontalAlignment="Left"
                               Visibility="Collapsed"/>
                    <CalendarDatePicker Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed">

                    </CalendarDatePicker>
                    <TextBox Grid.Column="2" x:Uid="Db_SearchBox"
                             PlaceholderText="Search"
                             Width="250"
                             HorizontalAlignment="Right"
                             Margin="0,0,20,0" Visibility="Collapsed" FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"/>
                </Grid>

                <!-- Scrollable GridView -->

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- New Design Line:85~158 -->
                    <!-- Scrollable main content area (Row 0).
                    Holds the dashboard’s dynamic content so users can scrollwhen data exceeds the visible space. -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <!-- Outer ListView: scrolls across days -->
                        <ListView ItemsSource="{Binding GroupedSummaries}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Visibility="Visible"
                                  x:Name="MainListView">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="350"
                                                   MaximumRowsOrColumns="2"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DoctorGroup">
                                    <Border Background="White"
                                            CornerRadius="7"
                                            Margin="5"
                                            BorderBrush="#ccc"
                                            BorderThickness="1"
                                            Width="300"
                                            Height="200">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Date header -->
                                            <Border Grid.Row="0" Background="#e0e0e0" CornerRadius="7,7,0,0">
                                                <TextBlock Text="{Binding DateLabel}"
                                                           FontSize="18"
                                                           Foreground="#333"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Height="33"
                                                           Margin="0,5,0,3"
                                                           FontFamily="{StaticResource CurrentAppFont}"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Doctors list (scrolls inside card if too long) -->
                                            <ListView Grid.Row="1"
                                                      x:Name="DoctorSummeryListView"
                                                      ItemsSource="{Binding Doctors}"
                                                      IsItemClickEnabled="False"
                                                      SelectionMode="None"
                                                      ScrollViewer.VerticalScrollMode="Auto"
                                                      HorizontalAlignment="Stretch"
                                                      MaxHeight="200"
                                                      Visibility="Visible">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DoctorWeeklySummary">
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,7"
                                                                    DoubleTapped="DoctorStackPanel_DoubleTapped"
                                                                    ToolTipService.ToolTip="Double tap to check Patients and control them"
                                                                    x:Uid="Db_DoctorSummaryStack">
                                                            <TextBlock Text="👨‍⚕️" Margin="10,0,3,0"/>
                                                            <TextBlock Text="{Binding DoctorName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" - " Margin="5,0"/>
                                                            <TextBlock Text="{Binding PatientCount}" Foreground="Gray"/>
                                                            <TextBlock Text="patients" Foreground="Gray" Margin="0,0,0,3"
                                                                       x:Uid="Db_PatientsLabel"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                    
                    <!-- End of New Design-->
                </Grid>

            </Grid>


            <!-- Right Column Content -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Refresh Button -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Title -->
                    <RowDefinition Height="2.85*"/> <!-- Row 2: ListView -->
                    <RowDefinition Height="1.15*"/> <!-- Row 3: Summary Info -->
                </Grid.RowDefinitions>

                <!-- Scrollable content -->

                    <Button Grid.Row="0"
                            x:Uid="Db_RefreshCalendarButton"
                            Content="Refresh Calendar"
                            Margin="5, 5, 10, 5"
                            Background="RoyalBlue"
                            Foreground="White" 
                            HorizontalAlignment="Right"
                            Command="{Binding Btn_refresh}" 
                            FontFamily="{StaticResource CurrentAppFont}" 
                            FontWeight="Bold"
                            Width="160"
                            Height="37"/>


                <StackPanel Grid.Row="1" Spacing="2" Orientation="Vertical">
                    <TextBlock x:Uid="Db_AppointmentsLabel" 
                               Text="Appointments" 
                               FontSize="22" Margin="15"
                               HorizontalAlignment="Center"
                               MaxHeight="50" FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="1" Margin="5" HorizontalAlignment="Center">
                        <!-- Doctor Name -->
                        <TextBlock Text="{Binding SelectedDoctorName}" FontFamily="{StaticResource CurrentAppFont}" 
                                   Margin="3,0,3,7"                           
                                   FontWeight="Bold"
                                   x:Name="DoctorNameTopList"
                                   FontSize="18"
                                   Foreground="RoyalBlue"
                                   />
                        <TextBlock Text="-" 
                                   Margin="3,0,3,7"
                                   FontFamily="{StaticResource CurrentAppFont}" 
                                   FontWeight="Bold"
                                   x:Name="DashTopList"
                                   FontSize="18"
                                   Visibility="{Binding IsListVisible}"
                                   Foreground="RoyalBlue"/>
                        <TextBlock Text="{Binding SelectedDoctorSpecialty}" 
                                   FontFamily="{StaticResource CurrentAppFont}" 
                                   FontWeight="Bold"
                                   Margin="3,0,3,7"
                                   FontSize="18"
                                   x:Name="DoctorSpecialtyTopList"
                                   Foreground="RoyalBlue"/>
                    </StackPanel>                    
                </StackPanel>

                <!-- ListView -->
                    <Grid Grid.Row="2">

                    <ListView ItemsSource="{Binding ScheduledAppointmentDisplay, Mode=OneWay}"
                              SelectedItem="{Binding SelectedDisplayPatient, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              x:Name="PatienFilterInDashBoard"
                              Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScheduledAppointmentDisplay">
                                <Grid>
                                    <!-- Added here Doctor naem but itiwll show wiht each Patient-->
                                        <StackPanel Orientation="Horizontal" Spacing="5">

                                            <!-- Patient Name -->
                                            <TextBlock Text="{Binding PatientName}" FontFamily="{StaticResource CurrentAppFont}" 
                                                   FontWeight="SemiBold"
                                                   MinWidth="100"
                                                   Margin="5, 5, 5, 15"/>

                                            <!-- Appointment Time -->
                                            <TextBlock Text="{Binding AppointmentTimeFormatted}" FontFamily="{StaticResource CurrentAppFont}" 
                                                   FontWeight="SemiBold"
                                                   MinWidth="100"
                                                   Margin="5"/>

                                        </StackPanel>

                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,20,0,0">

                                        <!-- Is Attending Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <RadioButton x:Uid="Db_AttendingRadio" 
                                                         Content="Attending"
                                                         GroupName="AttendanceStatus"
                                                         IsChecked="{Binding AttendStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CurrentlyAttending, Mode=TwoWay}"
                                                         Tapped="RadioButton_Tapped"
                                                         VerticalAlignment="Center"
                                                         Grid.Column="0"
                                                         IsEnabled="{Binding CanEditAppoitment}"
                                                         FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"
                                                         Foreground="Teal"/>

                                            <Ellipse Width="15" Height="15"
                                                     Margin="18,0,0,0"
                                                     Fill="{Binding Visuals.CircleColor}"
                                                     Stroke="{Binding Visuals.CircleColor}"
                                                     StrokeThickness="1"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Visuals.AttendingVisibility}"
                                                     Grid.Column="1"/>
                                        </Grid>

                                        <!-- Is Attended Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <RadioButton x:Uid="Db_AttendedRadio"
                                                         Content="Attended"
                                                         GroupName="AttendanceStatus"
                                                         IsChecked="{Binding AttendStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Attended, Mode=TwoWay}"
                                                         Tapped="RadioButton_Tapped"
                                                         VerticalAlignment="Center"
                                                         Grid.Column="0"
                                                         IsEnabled="{Binding CanEditAppoitment}"
                                                         FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"
                                                         Foreground="RoyalBlue"/>

                                            <Ellipse Width="15" Height="15"
                                                     Margin="18,0,0,0"
                                                     Fill="{Binding Visuals.CircleColor}"
                                                     Stroke="{Binding Visuals.CircleColor}"
                                                     StrokeThickness="1"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Visuals.AttendedVisibility}"
                                                     Grid.Column="1"/>
                                        </Grid>

                                        <!-- Is Missed Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <RadioButton x:Uid="Db_MissedRadio"
                                                         Content="Missed"
                                                         GroupName="AttendanceStatus"
                                                         IsChecked="{Binding AttendStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Missed, Mode=TwoWay}"
                                                         Tapped="RadioButton_Tapped"
                                                         VerticalAlignment="Center"
                                                         Grid.Column="0"
                                                         IsEnabled="{Binding CanEditAppoitment}"
                                                         FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"
                                                         Foreground="IndianRed"/>

                                            <Ellipse Width="15" Height="15"
                                                     Margin="18,0,0,0"
                                                     Fill="{Binding Visuals.CircleColor}"
                                                     Stroke="{Binding Visuals.CircleColor}"
                                                     StrokeThickness="1"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Visuals.MissedVisibility}"
                                                     Grid.Column="1"/>

                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>

                <StackPanel Grid.Row="3" Margin="10" Orientation="Vertical" Spacing="5">
                    <!-- Header -->
                    <TextBlock x:Uid="Db_TodaySummaryLabel"
                               Text="📊 Today Summary"
                               FontSize="16"
                               FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center"/>

                    <!-- Summary Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Spacing="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Db_DoctorsSummaryLabel" Text="👥 Doctors:" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="0"/>
                                <TextBlock Text="{Binding TotalDoctors}" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Db_TodaysVisitsSummaryLabel"
                                           Text="🗓️ Today's Visits:"
                                           Grid.Column="0"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalPatients}" 
                                           Grid.Column="1" Margin="5,0,0,0"
                                           FontFamily="{StaticResource CurrentAppFont}" FontWeight="SemiBold"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Db_AttendingSummaryLabel" Text="🩺 Attending:" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="0"/>
                                <TextBlock Text="{Binding AttendingNow}" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Spacing="8">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Db_AttendedSummaryLabel" Text="✅ Attended:" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="0"/>
                                <TextBlock Text="{Binding Attended}" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Db_MissedSummaryLabel" Text="❌ Missed:" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="0"/>
                                <TextBlock Text="{Binding MissedAppointments}" FontFamily="{StaticResource CurrentAppFont}" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </Grid>

        </Grid>


        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource CurrentAppFont}"        
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoTextDashboard"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>

    </Grid>
</Page>
