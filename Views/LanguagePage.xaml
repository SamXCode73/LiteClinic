<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.LanguagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:models="using:LiteClinic.Models"    
    d:DataContext="{d:DesignInstance Type=viewmodels:LanguagePageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">


    <!-- This page has noe viemodel -->
    <Page.DataContext>
        <d:DesignInstance Type="viewmodels:AppState" IsDesignTimeCreatable="True"/>
    </Page.DataContext>

    <Grid>

        <!-- Language Selection -->
        
            <StackPanel Spacing="20" HorizontalAlignment="Center" Margin="20" Grid.Row="0">

            <TextBlock x:Uid="Stp_LanguageSelectionComboBox" 
                       Text="Language"
                       FontFamily="{StaticResource CurrentAppFont}"
                       FontWeight="Bold"
                       FontSize="18"
                       Margin="20"/>
                
            <Border BorderBrush="#CCC" BorderThickness="3" CornerRadius="3" Padding="10">
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                      SelectedValuePath="Code"
                      Width="250"
                      Height="70"
                      Margin="0,0,0,5"
                      FontFamily="{StaticResource CurrentAppFont}"
                      FontWeight="Bold"
                      FontSize="16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LanguageOption">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Image Source="{Binding FlagPath}" Width="18" Height="18"/>
                                <TextBlock x:Uid="Stp_LanguageSelectionItemText"
                                           Text="{Binding Name}" Margin="5,0,0,0"
                                           FontWeight="Bold"
                                           FontFamily="{StaticResource CurrentAppFont}"
                                           FontSize="16"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
                
        </StackPanel>


    </Grid>
</Page>
