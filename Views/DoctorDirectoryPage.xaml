<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.DoctorDirectoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LiteClinic.Models"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:services="using:LiteClinic.Services"    
    d:DataContext="{d:DesignInstance Type=viewmodels:DoctorDirectoryPageViewModel, IsDesignTimeCreatable=True}"    
    mc:Ignorable="d"
    Background="#f1f1f1"
    x:Name="DoctorDirectory">

    <Page.Resources>
        <services:ProfilePictureConverter x:Key="ProfilePictureConverter"/>
    </Page.Resources>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <!-- Top navigation -->
                <RowDefinition Height="Auto"/>
                <!-- Content frame -->
                <RowDefinition Height="*"/>
                <!-- Content Status bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Background="#F8F9FA" Padding="20" VerticalAlignment="Top" x:Name="SearchSection">
                <TextBlock x:Uid="DDP_DoctorDirectory" Text="Doctor Directory" FontSize="28" FontWeight="Bold"/>
                <TextBox x:Uid="DDP_SearchBox" PlaceholderText="Search by name or specialty"
                     Margin="0,10,0,0"
                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Filter Row -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Day Chips -->
                    <ItemsControl ItemsSource="{Binding AttendingDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Specialty Dropdown -->
                    <ComboBox  x:Uid="DDP_SpecialtyComboBox" 
                           ItemsSource="{Binding Specializations}" 
                           SelectedItem="{Binding SelectedSpecialization, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                           PlaceholderText="Specialty" Margin="10,0,0,0"
                           x:Name="SpecialtyComboBoxFilter"/>

                    <!-- Availability Toggles -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Spacing="3">
                        <ToggleButton x:Uid="DDP_MorningToggle" Content="Morning" 
                                  IsChecked="{Binding IsMorningSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <ToggleButton x:Uid="DDP_AfternoonToggle" Content="Afternoon" 
                                  IsChecked="{Binding IsAfternoonSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <ToggleButton x:Uid="DDP_EveningToggle" Content="Evening" 
                                  IsChecked="{Binding IsEveningSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Available Today Badge -->
                    <ToggleButton x:Uid="DDP_AvailableTodayToggle" Content="Available Today" Margin="10,0,0,0" 
                              IsChecked="{Binding IsTodaySelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <Button x:Uid="DDP_RefreshButton" Content="Refresh" 
                        Margin="10,0,0,0"
                        Background="RoyalBlue"
                        Foreground="White"
                        Command="{Binding RefreshCommandAsync}"/>

                    <!-- Legend Section -->
                    <StackPanel Margin="25,0,0,0" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right">
                        <!-- Teal Legend -->
                        <Rectangle Width="16" Height="16" 
                   Fill="Teal" Stroke="Black" StrokeThickness="0.5" HorizontalAlignment="Right"/>
                        <TextBlock x:Uid="DDP_TodayDoctorsLegend" 
                               Text="Today’s Doctors" 
                               VerticalAlignment="Center"/>
                        <!-- Royal Blue Legend -->
                        <Rectangle Width="16" Height="16"                            
                   Fill="RoyalBlue" Stroke="Black" StrokeThickness="0.5" HorizontalAlignment="Right"/>
                        <TextBlock x:Uid="DDP_FilteredDoctorsLegend" 
                               Text="Filtered Doctors" 
                               VerticalAlignment="Center"/>

                        <Rectangle Width="16" Height="16"                            
                   Fill="DarkViolet" Stroke="Black" StrokeThickness="0.5" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        <TextBlock x:Uid="DDP_FilteredDoctorsLegendByTime" 
                               Text="Filtered by time" 
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>

            </StackPanel>

            <!-- Doctor Cards Grid -->
            <Grid Margin="15" Grid.Row="1" x:Name="DoctorCardGrid">
                <GridView  x:Name="DoctorGrid" ItemsSource="{Binding DoctorCards}" Margin="5">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:DoctorCardModel">
                            <Grid Margin="5"
                              Padding="5" Background="{Binding DayBackground, FallbackValue=Transparent}">
                                <Border Background="White" CornerRadius="8" Padding="12" Margin="10"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                Width="300" Height="320">
                                    <StackPanel>
                                        <!-- Header row: avatar + name -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Padding="15,0,0,0">

                                            <!-- Circle avatar -->
                                            <!-- Photo -->
                                            <Ellipse Width="40" Height="40" Grid.Column="2" 
                                                 Stroke="Gray" 
                                                 StrokeThickness="1"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,10,0">
                                                <Ellipse.Fill>
                                                    <ImageBrush Stretch="UniformToFill">
                                                        <ImageBrush.ImageSource>
                                                            <BitmapImage UriSource="{Binding ProfilePicturePath, 
                                                            Mode=TwoWay, 
                                                            Converter={StaticResource ProfilePictureConverter}}" 
                                                                     CreateOptions="IgnoreImageCache"/>
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- Doctor name and specialty -->
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Specialization}" FontSize="14" 
                                                       Foreground="{Binding SpecializationForeground}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock x:Uid="DDP_TimeSlots" Text="Time Slots:" FontWeight="Bold" Margin="0,8,0,0" Padding="15,0,0,0"/>

                                        <!-- Scrollable area for long schedules -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="155">
                                            <ItemsControl ItemsSource="{Binding DaySlots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,0">
                                                            <!-- Day name in bold -->
                                                            <TextBlock Text="{Binding DaySelected}" 
                                                                   FontSize="13"
                                                                   Padding="15,0,0,0"
                                                                   Foreground="{Binding DayForeground, FallbackValue=Black}"
                                                                   FontWeight="{Binding DayFontWeight}"/>

                                                            <!-- Time slots under the day -->
                                                            <ItemsControl ItemsSource="{Binding SlotsSelected}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding TimeSelected}" 
                                                                               FontSize="13" Margin="20,0,0,0"
                                                                               Padding="10,0,0,0"
                                                                               Foreground="{Binding SlotForeground, FallbackValue=Black}"
                                                                               FontWeight="{Binding SlotFontWeight}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Action buttons -->
                                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="ProfileButton" x:Uid="DDP_ViewProfileButton" Background="LightGray" Foreground="Black"
                                                    Content="View Profile" Margin="0,0,8,0" MinWidth="100"
                                                    CornerRadius="6"
                                                    Command="{Binding DataContext.Btn_OpenProfilePage, ElementName=DoctorGrid}"
                                                    CommandParameter="{Binding}"/>
                                                <Button x:Uid="DDP_BookAppointmentButton" 
                                                    Content="Book Appointment" MinWidth="120" Background="RoyalBlue" Foreground="White"
                                                    CornerRadius="6" 
                                                    Command="{Binding DataContext.Btn_OpenAppointmentPage, ElementName=DoctorGrid}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
            <!-- Info bar -->
            <Border x:Name="InforbarBordder" Grid.Row="2"
        Background="#dcdcdc"
        Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left-aligned Roman date -->
                    <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                    <!-- Centered system status -->
                    <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource CurrentAppFont}"        
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoTextDashboard"/>

                    <!-- Right-aligned Hijri date -->
                    <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
                </Grid>
            </Border>


            <!-- Pupop Doctor Infor-->
        <Grid x:Name="PopupGridRoot" VerticalAlignment="Top" Margin="15">
            <Popup x:Name="DoctorProfilePopup"
                   VerticalOffset="0" 
                   HorizontalOffset="0"
                   IsLightDismissEnabled="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsOpen="{Binding IsDoctorProfilePopupOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=PopupGridRoot}">


                <Border Background="White"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="LightGray"
                        BorderThickness="2"
                        Width="{Binding PopupActualWidth}"
                        Height="{Binding PopupActualHeight}">

                    <StackPanel Spacing="15">

                        <!-- Top row: Name + Avatar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Left: Doctor name + specialization -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDoctor.FullName}"
                               FontSize="24"
                               FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDoctor.Specialization}"
                               FontSize="16"
                               Foreground="DarkMagenta"/>
                            </StackPanel>

                            <!-- Right: Avatar -->
                            <Ellipse Grid.Column="1"
                         Width="100" Height="100"
                         Stroke="Gray" StrokeThickness="1"
                         Margin="20,0,0,0">
                                <Ellipse.Fill>
                                    <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding SelectedDoctor.ProfilePicturePath, Converter={StaticResource ProfilePictureConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- Details section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Gender:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedDoctor.Gender}" Margin="20,0,0,0"/>

                            <TextBlock Text="Mobile Phone:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedDoctor.PhoneNumber}" Margin="20,0,0,0"/>

                            <TextBlock Text="Landline:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedDoctor.LandLineNumber}" Margin="20,0,0,0"/>
                        </StackPanel>

                        <!-- Bottom buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,0">
                            <Button x:Uid="DDP_SendEmergencyCallBtn" 
                                    Content="Send Emergency Alert"
                                    Background="Red"
                                    Foreground="WhiteSmoke"
                                    IsEnabled="True"/>

                            <Button x:Uid="DDP_CloseBtn" 
                                    Content="Close" 
                                    Background="LightGray" 
                                    Foreground="Black" 
                                    Command="{Binding Btn_CloseProfilePage}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>



        <!--Root Gird Closed -->
        </Grid>
</Page>
