<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:services="using:LiteClinic.Services"
    d:DataContext="{d:DesignInstance Type=viewmodels:UsersViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
    </Page.Resources>


    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F3" Invoked="UserPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="UserPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid>

        <!-- Define two rows: main content and bottom info bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>


        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                
            </Grid.ColumnDefinitions>
            <!-- Main Content-->

            <ScrollViewer Grid.Row="0" Grid.Column="0" Padding="20">
                <StackPanel Spacing="10" Margin="5">
                    <!-- Basic Info -->
                    <TextBlock x:Uid="Usrp_UserManager"
                               x:Name="UserManager" 
                               Text="User Manager" 
                               FontSize="16" 
                               FontFamily="{StaticResource CurrentAppFont}" 
                               FontWeight="Bold"/>

                    <TextBox x:Uid="Usrp_UsernameBox"
                             Header="Username" 
                             x:Name="UsernameBox"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Enter New Username"/>

                    <PasswordBox x:Uid="Usrp_PasswordBox"
                                 Header="Password" 
                                 x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 PlaceholderText="Enter Password"/>

                    <PasswordBox x:Uid="Usrp_ConfirmPasswordBox" 
                                 Header="Confirm Password" 
                                 x:Name="ConfirmPasswordBox"
                                 PasswordChanged="PasswordBoxConfirm_PasswordChanged"
                                 PlaceholderText="Confirm Password"/>

                    <TextBox x:Uid="Usrp_FullNameBox"
                             Header="Full Name" 
                             x:Name="FullNameBox"
                             Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox x:Uid="Usrp_EmailBox"
                             Header="Email" 
                             x:Name="EmailBox"
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox x:Uid="Usrp_PhoneBox"
                             Header="Phone Number" 
                             x:Name="PhoneBox"
                             Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox x:Uid="Usrp_LandLineBox"
                             Header="Landline Number" 
                             x:Name="LandLineBox"
                             Text="{Binding LandLineNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox x:Uid="Usrp_LanguageBox"
                              Header="Language" 
                              x:Name="LanguageBox"
                              SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Content">

                        <ComboBoxItem x:Uid="Usrp_Language_enUS" 
                                      Content="en-US"/>

                        <ComboBoxItem x:Uid="Usrp_Language_ar"
                                      Content="ar"/>
                    </ComboBox>


                    <!-- Permissions -->
                    <StackPanel>
                        <TextBlock x:Uid="Usrp_PermissionsLabel"
                                   Text="Permissions" 
                                   FontFamily="{StaticResource CurrentAppFont}" 
                                   FontWeight="Bold" Margin="0,20,0,10"/>

                        <ComboBox x:Uid="Usrp_RoleNameBox"
                                  x:Name="RoleNameBox"
                                  ItemsSource="{Binding Roles}"
                                  SelectedValue="{Binding RoleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="RoleId"
                                  DisplayMemberPath="RoleName"
                                  Header="Select Role"
                                  Width="200">

                        </ComboBox>

                    </StackPanel>


                    <StackPanel>
                        <CheckBox x:Uid="Usrp_IsActiveCheckBox"
                                  Content="Is Active" Margin="0,2" 
                                  IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal">
                        <!-- Submit Button -->
                        <Button x:Uid="Usrp_AddButton"
                                Content="Add"  
                                Margin="10" 
                                Background="Teal" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanAddUsers}"
                                Command="{Binding Btn_SaveUserCommand}"
                                ToolTipService.ToolTip="Save/F1"/>

                        <Button x:Uid="Usrp_EditButton"
                                Content="Edit"  
                                Margin="10" 
                                Background="RoyalBlue" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditUsers}"
                                Command="{Binding Btn_UpdateUserCommand}"
                                ToolTipService.ToolTip="Update/F2"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <!-- Submit Button -->
                        <Button x:Uid="Usrp_DeactivateButton"
                                Content="Deactivate" 
                                Margin="10" 
                                Background="Red" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanDeactivateUsers}"
                                Command="{Binding Btn_DeactivateRoleCommadn}"
                                ToolTipService.ToolTip="Deactivate/F3"/>

                        <Button x:Uid="Usrp_ClearButton"
                                Content="Clear"  
                                Margin="10" 
                                Background="LightGray" 
                                Foreground="Black" 
                                Width="90"
                                Command="{Binding Btn_ClearCommand}"
                                ToolTipService.ToolTip="Clear Data (refresh)/F4"/>
                    </StackPanel>


                </StackPanel>

            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Border Width="1" Background="Gray" Margin="5"/>

            </StackPanel>

            <Grid Column="1" Grid.Row="0" 
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Uid="Usrp_UsersManagerListLabel" Grid.Column="0"
                           Text="Users Manager List"
                           HorizontalAlignment="Left"
                           FontFamily="{StaticResource CurrentAppFont}"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="15, 20, 5, 5"/>

                <Button x:Uid="Usrp_AddUserRoleButton" Grid.Column="1" Content="Add User's Role"
                        Margin="5, 5, 20, 5"
                        Background="RoyalBlue"
                        Foreground="White" 
                        HorizontalAlignment="Right"
                        Click="Button_Click_OpenUserRolePage"
                        FontFamily="{StaticResource CurrentAppFont}"
                        FontWeight="Bold"/>
            </Grid>
            
            <!-- User Manager -->
            <ListView x:Name="ListViewUsers"
          Grid.Row="0"
          Grid.Column="1"
          Margin="50"
          SelectionMode="Single"
          ItemsSource="{Binding Users}"
          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
          DoubleTapped="ListView_DoubleTapped"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Enabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          HorizontalContentAlignment="Left">

                <!-- Column headers -->
                <ListView.Header>
                    <Grid ColumnDefinitions="100,150,200,220,200,150,150,110,100,140,150"
                          Background="LightGray" Height="30">
                        <TextBlock Text="Auto" Grid.Column="0" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="User ID" Grid.Column="1" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Username" Grid.Column="2" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Full Name" Grid.Column="3" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Email" Grid.Column="4" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Mobile Phone" Grid.Column="5" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Land Line Phone" Grid.Column="6" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Language" Grid.Column="7" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Role" Grid.Column="8" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Role Name" Grid.Column="9" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        <TextBlock Text="Active" Grid.Column="10" Style="{StaticResource CustomColumnHeaderStyle}"/>
                    </Grid>
                </ListView.Header>

                <!-- Row template -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="100,150,200,220,200,150,150,110,100,140,150" Height="30">
                            <!-- Auto -->
                            <TextBlock Text="{Binding UserAutoId}" Grid.Column="0"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- User ID -->
                            <TextBlock Text="{Binding UserId}" Grid.Column="1"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Username -->
                            <TextBlock Text="{Binding Username}" Grid.Column="2"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Full Name -->
                            <TextBlock Text="{Binding FullName}" Grid.Column="3"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Email -->
                            <TextBlock Text="{Binding Email}" Grid.Column="4"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Mobile Phone -->
                            <TextBlock Text="{Binding PhoneNumber}" Grid.Column="5"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Land Line Phone -->
                            <TextBlock Text="{Binding LandLineNumber}" Grid.Column="6"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Language -->
                            <TextBlock Text="{Binding Language}" Grid.Column="7"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Role -->
                            <TextBlock Text="{Binding RoleId}" Grid.Column="8"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Role Name -->
                            <TextBlock Text="{Binding RoleName}" Grid.Column="9"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                       Style="{StaticResource CustomCellStyle}"/>

                            <!-- Active -->
                            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Grid.Column="10"
                                      Content="Active"
                                      Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                      HorizontalAlignment="Center"
                                      Margin="20,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>



        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>

    </Grid>
</Page>
