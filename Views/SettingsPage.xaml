<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:models="using:LiteClinic.Models"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">

    <!-- This page has noe viemodel -->
    <Page.DataContext>
        <d:DesignInstance Type="viewmodels:AppState" IsDesignTimeCreatable="True"/>
    </Page.DataContext>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Main content grid (Row 0 of the Page) -->

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- Left menu -->
                <ColumnDefinition Width="*"/>
                <!-- Content frame -->
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Menu -->
            <NavigationView Grid.Column="0"
                            PaneDisplayMode="Left"
                            IsSettingsVisible="False"
                            SelectionChanged="NavView_SelectionChanged"
                            BackRequested="NavView_BackRequested"
                            IsBackButtonVisible="Visible"
                            Background="#f1f1f1"
                            IsPaneToggleButtonVisible="False"
                            x:Name="NavView">

                <NavigationView.MenuItems>

                    <NavigationViewItem x:Uid="SPNV_Theme"
                                        Content="Theme" ToolTipService.ToolTip="Change application theme"
                                        Tag="Theme">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_Language"
                                        Content="Language" ToolTipService.ToolTip="Change application language"
                                        Tag="Language">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Globe"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_Calendar"
                                        Content="Calendar" ToolTipService.ToolTip="Manage calendar settings"
                                        Tag="Calendar">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Calendar"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_WorkingDays"
                                        Content="Working Days" ToolTipService.ToolTip="Configure clinic working days"
                                        Tag="WorkingDays">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Clock"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_Notifications"
                                        Content="Notifications" ToolTipService.ToolTip="Manage notification preferences"
                                        Tag="Notifications">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Message"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_ClinicName"
                                        Content="Clinic Name" ToolTipService.ToolTip="Edit clinic name and details"
                                        Tag="ClinicName">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Contact"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_Backup"
                                        Content="Backup" ToolTipService.ToolTip="Backup clinic data"
                                        Tag="Backup">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Save"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Uid="SPNV_Logs"
                                        Content="Logs" ToolTipService.ToolTip="View system logs and activity history"
                                        Tag="Logs">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Document"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>
            
            <!-- Content Frame -->
            <Frame x:Name="SettingsFrame" Grid.Column="1"/>
        </Grid>


        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>

    </Grid>
</Page>