<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:models="using:LiteClinic.Models"
    d:DataContext="{d:DesignInstance Type=viewmodels:NotificationsPageViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Grid>

        <!-- Column 2: Notifications -->
        <StackPanel Margin="20" Spacing="10" HorizontalAlignment="Center">
            <TextBlock x:Uid="Stp_NotificationsTitle"
                                   Text="Notifications"
                                   FontSize="18"
                                   FontFamily="{StaticResource CurrentAppFont}"
                                   FontWeight="Bold"
                                   Margin="20"/>
            <Border BorderBrush="#CCC" BorderThickness="3" CornerRadius="3" Padding="10">
                <StackPanel>
                    <CheckBox x:Uid="Stp_NotifyPatient24hCheckBox"
                                  Content="Send patient notification 24h before appointment"
                                  IsChecked="{Binding NotifyPatient24h, Mode=TwoWay}" Margin="5"
                                  IsEnabled="{Binding SendViaTelegram, Mode=TwoWay}"/>

                    <CheckBox x:Uid="Stp_NotifyPatient2hCheckBox"
                                  Content="Send patient notification 2h before appointment"
                                  IsChecked="{Binding NotifyPatient2h, Mode=TwoWay}" Margin="5"
                                  IsEnabled="{Binding SendViaTelegram, Mode=TwoWay}"/>

                    <CheckBox x:Uid="Stp_NotifyDoctorCheckBox"
                                  Content="Enable doctor notifications"
                                  IsChecked="{Binding NotifyDoctor, Mode=TwoWay}" Margin="5"
                                  IsEnabled="{Binding SendViaTelegram, Mode=TwoWay}"/>

                    <CheckBox x:Uid="Stp_SendViaTelegramCheckBox"
                                  Content="Send via Telegram"
                                  IsChecked="{Binding SendViaTelegram, Mode=TwoWay}" Margin="5"/>
                </StackPanel>
            </Border>

            <Button x:Uid="Stp_NavigateConfigPageButton"
                                Content="Go to Configuration Page Helper"
                                Margin="10"
                                Background="Teal"
                                Foreground="AntiqueWhite"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"
                                IsEnabled="{Binding CanManageSettingsMenu}"
                                Command="{Binding NavigateToConfigPageCommand}"/>
        </StackPanel>

    </Grid>
</Page>
