<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.UserRoleManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    xmlns:services="using:LiteClinic.Services"
    d:DataContext="{d:DesignInstance Type=viewmodels:UserRoleViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <services:DeactivationToBrushConverter x:Key="DeactivationToBrushConverter"/>
        <services:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <services:BoolToBrushConverterForRed x:Key="BoolToBrushConverterForRed"/>
        <SolidColorBrush x:Key="CheckBoxForeground" Color="Red"/>
        <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="Red"/>
        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="Red"/>
        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="Red"/>
        <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="Red"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F3" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!-- Define two rows: main content and bottom info bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>

        <!-- Main content -->

        <!-- Column 0 User Role Data / Column 1 Virtical Border   /  Column 2 User Role lIst-->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  >

                <StackPanel Grid.Column="0" Margin="20" HorizontalAlignment="Left">
                    <TextBlock x:Uid="UrLp_AddNewRole"
                               Text="Add New Role" FontSize="18" FontWeight="Bold" 
                               FontFamily="{StaticResource CurrentAppFont}"
                               Margin="10"/>

                    <!-- Role Name -->
                    <TextBlock x:Uid="UrLp_RoleNameLabel"
                               Text="Role Name:" Margin="5"
                               FontFamily="{StaticResource CurrentAppFont}"
                               FontWeight="Bold"
                               FontSize="16"/>

                    <TextBox x:Uid="UrLp_RoleNameBox"
                             Text="{Binding RoleName, Mode=TwoWay}" 
                             Margin="0,0,0,10"  
                             Width="200"
                             PlaceholderText="Enter New Role Name"/>

                    <!-- Permissions -->
                    <TextBlock x:Uid="UrLp_PermissionsLabel"
                               Text="Permissions:" FontWeight="Bold" Margin="0,10,0,5" FontFamily="{StaticResource CurrentAppFont}"/>
                    <StackPanel>

                        <CheckBox x:Uid="UrLp_CanManageDoctors"
                				  Content="Can Manage Doctors"
                                  IsChecked="{Binding CanManageDoctors, Mode=TwoWay}">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>

                        <CheckBox x:Uid="UrLp_CanManageUsers"
                                  Content="Can Manage Users" Margin="0,2" IsChecked="{Binding CanManageUsers, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Manage User Only: ADD">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>


                        <StackPanel Orientation="Vertical" Spacing="1">

                            <CheckBox x:Uid="UrLp_UserAdd"
                                      Content="Add" Margin="20, 3,0,0" IsChecked="{Binding CanManageUsers, Mode=TwoWay}" 
                                      Foreground="Teal" FontWeight="SemiBold" FontStyle="Italic" Visibility="Collapsed"/>

                            <CheckBox x:Uid="UrLp_UserEdit"
                                      Content="Edit" Margin="20, 3,0,0" IsChecked="{Binding CanManageUsers, Mode=TwoWay}" 
                                      Foreground="RoyalBlue" FontWeight="SemiBold" FontStyle="Italic" Visibility="Collapsed"/>

                            <CheckBox x:Uid="UrLp_UserDeactivate"
                                      Content="Deactivate" Margin="20, 3,0,0" IsChecked="{Binding CanManageUsers, Mode=TwoWay}" 
                                      Foreground="IndianRed" FontWeight="SemiBold" FontStyle="Italic" Visibility="Collapsed"/>
                                

                            </StackPanel>
                    </StackPanel>

                    <CheckBox x:Uid="UrLp_CanAccessDashboard"
                              Content="Can Access Dashboard" Margin="0,2" IsChecked="{Binding CanAccessDashboard, Mode=TwoWay}">
                        <CheckBox.FontWeight>
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                        </CheckBox.FontWeight>
                    </CheckBox>


                    <CheckBox x:Uid="UrLp_CanViewAppointments"
                              Content="Can View Appointments" Margin="0,2" IsChecked="{Binding CanViewAppointments, Mode=TwoWay}">
                        <CheckBox.FontWeight>
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                        </CheckBox.FontWeight>
                    </CheckBox>


                    <CheckBox x:Uid="UrLp_CanManageRecords"
                              Content="Can Manage Records" Margin="0,2" IsChecked="{Binding CanManageRecords , Mode=TwoWay}"
                              ToolTipService.ToolTip="Manage Record Only: ADD">
                        <CheckBox.FontWeight>
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                        </CheckBox.FontWeight>
                    </CheckBox>


                    <CheckBox x:Uid="UrLp_CanEditRecords"
                              Content="Can Edit Records" Margin="0,2" IsChecked="{Binding CanEditRecords , Mode=TwoWay}"
                              ToolTipService.ToolTip="Manage Records: EDIT/DEACTIVATE">
                        <CheckBox.FontWeight>
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                        </CheckBox.FontWeight>
                    </CheckBox>


                    <Border BorderThickness="0.75"
                            Width="50"
                            BorderBrush="Silver">
                        
                    </Border>

                    <CheckBox x:Uid="UrLp_Deactivated"
                              Content="Deactivated"
                              Margin="0,2"
                              IsChecked="{Binding IsDeactivated, Mode=TwoWay}"
                              FontFamily="{StaticResource CurrentAppFont}"
                              ToolTipService.ToolTip="Deactivate Records"
                              FontWeight="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToFontWeightConverter}}"
                              Foreground="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToBrushConverterForRed}}"/>



                    <Border BorderThickness="0.75"
                            Width="50"
                            BorderBrush="Silver">
                    </Border>


                    <!-- Reports Section -->
                    <StackPanel>
                        <TextBlock x:Uid="UrLp_ReportSectionLabel"
                                   Text="Report section:"
                                   FontFamily="{StaticResource CurrentAppFont}"
                                   FontWeight="Bold" Margin="0,10,0,5"/>

                        <CheckBox x:Uid="UrLp_CanManageReports"
                                  Content="Can Manage Reports" Margin="0,2" IsChecked="{Binding CanManageReports, Mode=TwoWay}">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>


                        <CheckBox x:Uid="UrLp_CanViewReports"
                                  Content="Can View Reports" Margin="0,2" IsChecked="{Binding CanViewReports, Mode=TwoWay}">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>


                    </StackPanel>

                    <Border BorderThickness="0.75"
                            Width="50"
                            BorderBrush="Silver">
                    </Border>


                    <!-- Settings Section -->
                    <StackPanel Margin="0, 0, 0, 20">
                        <TextBlock x:Uid="UrLp_SettingsLabel"
                                   Text="Settings" 
                                   FontFamily="{StaticResource CurrentAppFont}"
                                   FontWeight="Bold" Margin="0,10,0,5"/>

                        <CheckBox x:Uid="UrLp_CanManageSettings"
                                  Content="Can Manage Settings" Margin="0,2" IsChecked="{Binding CanManageSettings, Mode=TwoWay}"
                                  ToolTipService.ToolTip="View and change Settings">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>


                        <CheckBox x:Uid="UrLp_CanViewSettings"
                                  Content="Can View Settings" Margin="0,2" IsChecked="{Binding CanViewSettings, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Only View,cannot change">
                            <CheckBox.FontWeight>
                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Mode=Self}" 
                                         Converter="{StaticResource BoolToFontWeightConverter}"/>
                            </CheckBox.FontWeight>
                        </CheckBox>

                    </StackPanel>

                    <Border BorderThickness="0.75"
                            Width="50"
                            BorderBrush="Silver">
                    </Border>

                    <!-- Save Button -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Uid="UrLp_AddButton"
                                Content="Add"
                                Background="Teal"
                                Foreground="White"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"                                
                                Margin="10"
                                Width="90"
                                IsEnabled="{Binding CanAddUserRole}"
                                Command="{Binding SaveRoleCommand}"
                                ToolTipService.ToolTip="Save Role F1"/>
                        <!-- Edit Button -->
                        <Button x:Uid="UrLp_EditButton"
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"
                                Content="Edit"  
                                Margin="10" 
                                Background="RoyalBlue" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditUserRole}"
                                Command="{Binding UpdateRoleCommand}"
                                ToolTipService.ToolTip="Edit Role F2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Deactivate Button -->
                        <Button x:Uid="UrLp_DeactivateButton"
                                Content="Deactivate" 
                                Margin="10" 
                                Background="Red" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanDeactivateUserRole}"
                                Command="{Binding Btn_DeactivateRoleCommadn}" 
                                ToolTipService.ToolTip="Deactivate Role F2"/>
                        <!-- Clear Button -->
                        <Button x:Uid="UrLp_ClearButton"
                                Content="Clear"  
                                Margin="10" 
                                FontFamily="{StaticResource CurrentAppFont}"
                                FontWeight="Bold"                                
                                Background="LightGray" 
                                Foreground="Black" 
                                Width="90"
                                Command="{Binding Button_ClearRoleData}"
                                ToolTipService.ToolTip="Clear Fields F4"/>
                    </StackPanel>

                    <!-- Back to User Page Button -->
                    <Button x:Uid="UrLp_BackToUserPageButton"
                            Content="Back to User Page" 
                            Background="RoyalBlue"
                            Foreground="White"
                            Margin="10"
                            Width="200"
                            Click="Button_Click_BackToUserPage"
                            ToolTipService.ToolTip="Back to User Page"
                            FontFamily="{StaticResource CurrentAppFont}"
                            FontWeight="Bold"/>

                </StackPanel>

            </ScrollViewer>


            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Border Width="1" Background="Gray" Margin="5"/>

            </StackPanel>

            <!-- Existing Roles List -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <!-- For the TextBlock -->
                        <RowDefinition Height="Auto"/>
                        <!-- For the ScrollViewer -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="UrLp_ExistingRolesLabel"
                               Text="Existing Roles"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="18"
                               Grid.Row="0"
                               FontFamily="{StaticResource CurrentAppFont}"/>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto">

                        <ListView x:Uid="UrLp_RolesListView"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                  DoubleTapped="ListView_DoubleTapped"
                                  MinWidth="400">

                            <!-- Header -->
                            <ListView.Header>
                                <StackPanel Orientation="Horizontal" Padding="4" Background="LightGray">
                                    <TextBlock x:Uid="UrLp_RolesHeader"
                                               Text="ID" FontWeight="Bold" Width="50" 
                                               FontFamily="{StaticResource CurrentAppFont}"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Uid="UrLp_HeaderRoleName"
                                               Text="Role Name" FontWeight="Bold" Width="150" FontFamily="{StaticResource CurrentAppFont}"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Uid="UrLp_HeaderPermissions"
                                               Text="Permissions" FontWeight="Bold" Width="470" FontFamily="{StaticResource CurrentAppFont}"
                                               TextAlignment="Center"/>
                                    
                                </StackPanel>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Silver" BorderThickness="0,0,0,1" Padding="4">
                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock x:Uid="UrLp_RoleId"
                                                       Text="{Binding RoleId}" FontWeight="SemiBold" Width="50" />

                                            <TextBlock x:Uid="UrLp_RoleName"
                                                       Text="{Binding RoleName}" FontWeight="SemiBold" Width="150"
                                                   Foreground="{Binding IsDeactivated, Converter={StaticResource DeactivationToBrushConverter}}"/>

                                            <TextBlock x:Uid="UrLp_PermissionSummary" 
                                                       Text="{Binding PermissionSummary}"
                                                   TextWrapping="Wrap" Width="470"
                                                   Foreground="{Binding IsDeactivated, Converter={StaticResource DeactivationToBrushConverter}}"/>

                                            <TextBlock x:Uid="UrLp_IsDeactivatedHidden"
                                                       Text="{Binding IsDeactivated}" Visibility="Collapsed"/>
                                            
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Grid>
                
                <!-- Shortcuts Section -->
                <ScrollViewer Grid.Row="1"  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled">
                <Grid Margin="3" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="30">
                            <!-- Add -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FF008080" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="UrLp_AddShortcut"
                                           Text="Add = F1" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Edit -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FF4169E1" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="UrLp_EditShortcut"
                                           Text="Edit = F2" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Deactivate -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FFFF0000" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="UrLp_DeactivateShortcut"
                                           Text="Deactivate = F3" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Clear -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FFD3D3D3" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="UrLp_ClearShortcut"
                                           Text="Clear = F4" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Deactivate Row Color -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Uid="UrLp_DeactivatedUserLabel"
                                           Text="Deactivated User = " FontSize="14" FontWeight="Bold"/>
                                <Rectangle Width="16" Height="16" Fill="IndianRed" Stroke="White" Margin="0,0,5,0"/>
                            </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30" Margin="15">
                        <!-- Edit -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="RoyalBlue" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="UrLp_BackShortcut"
                                           Text="Back to User Page = F5" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                </ScrollViewer>

            </Grid>            
            

        </Grid>
  

        <!-- Info bar -->

        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource CurrentAppFont}"
                           FontWeight="Bold"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>
    </Grid>

</Page>
