<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"   
    d:DataContext="{d:DesignInstance Type=viewmodels:ReportsViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Background="#f1f1f1">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>

        <!-- Main content -->

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Section -->
            <TextBlock x:Uid="Rpg_Title"
                       Text="Clinic Activity Report"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"
                       Grid.Row="0"
                       FontFamily="{StaticResource CurrentAppFont}"/>

            <!-- Rest of the content goes in Grid.Row="1" -->

            <Grid Margin="10" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Clinic Summary -->
                <ScrollViewer Grid.Column="0" Background="AliceBlue"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Margin="10" Spacing="20">
                            <TextBlock x:Uid="Rpg_ClinicSummary"
                                       Text="Clinic Summary"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>

                            <!-- Explanation for zero counts -->
                            <TextBlock x:Uid="Rpg_NoteZeroCounts"
                                       Text="Note: Counts will remain 0 until appointments are marked as Attended or Missed for patients and doctors."
                                       FontSize="14"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"
                                       Width="350"
                                       FontWeight="SemiBold"/>
                            
                            <!-- Add summary cards and TopDoctors chart here -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                                
                            <!-- Total Doctors Count -->
                                <Border Background="#FFB5DDB5" Padding="20" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock x:Uid="Rpg_TotalLabel"
                                                   Text="Total" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>

                                        <TextBlock x:Uid="Rpg_DoctorsLabel"
                                                   Text="Doctors" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.TotalDoctors}" 
                                                   FontSize="24" FontWeight="Bold" Margin="0,5,0,10" 
                                                   HorizontalAlignment="Center" /> 

                                        <StackPanel Spacing="2">
                                            
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_TodayDoctors"
                                                           Text="Today: " FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>

                                                <TextBlock Text="{Binding ReportSummary.DoctorsToday}" 
                                                           FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_WeekDoctors"
                                                           Text="This Week:" FontSize="14" FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding ReportSummary.DoctorsThisWeek}" 
                                                           FontSize="15" FontWeight="SemiBold" />
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_MonthDoctors"
                                                           Text="This Month:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.DoctorsThisMonth}" 
                                                       FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_YearDoctors"
                                                           Text="This Year:" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ReportSummary.DoctorsThisYear}" 
                                                       FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>


                                <!-- Total Patients Count -->
                                <Border Background="#FFB0D4FF" Padding="20" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock x:Uid="Rpg_TotalLabelPatients"
                                                   Text="Total" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>

                                        <TextBlock x:Uid="Rpg_PatientsLabelCard"
                                                   Text="Patients" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.TotalPatients}" 
                                                   FontSize="24" FontWeight="Bold" Margin="0,5,0,10" 
                                                   HorizontalAlignment="Center" />

                                        <StackPanel Spacing="2">

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_TodayPatients"
                                                           Text="Today:" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                                
                                                <TextBlock Text="{Binding ReportSummary.PatientsToday}" 
                                                           FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_WeekPatients"
                                                           Text="This Week:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.PatientsThisWeek}" 
                                                           FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_MonthPatients"
                                                           Text="This Month:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.PatientsThisMonth}" 
                                                           FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_YearPatients"
                                                           Text="This Year:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.PatientsThisYear}" 
                                                           FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Missed Appointments -->
                                <Border Background="#FFEF8080" Padding="20" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock x:Uid="Rpg_MissedLabel"
                                                   Text="Missed" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>

                                        <TextBlock x:Uid="Rpg_AppointmentsLabel"
                                                   Text="Appointments" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.TotalMissedAppointments}" 
                                                   FontSize="24" FontWeight="Bold" Margin="0,5,0,10" 
                                                   HorizontalAlignment="Center" />

                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_TodayMissed"
                                                           Text="Today:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.MissedToday}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_WeekMissed"
                                                           Text="This Week:" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ReportSummary.MissedThisWeek}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_MonthMissed"
                                                           Text="This Month:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.MissedThisMonth}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock x:Uid="Rpg_YearMissed"
                                                           Text="This Year:" FontSize="14" FontWeight="SemiBold" />
                                                
                                                <TextBlock Text="{Binding ReportSummary.MissedThisYear}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                            

                            <!-- Top Doctors Section -->
                            <Border Padding="5" CornerRadius="10" Background="#FFd4ccff" Margin="5" Width="400">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="AUto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Margin="10">
                                        <TextBlock 
                                            Text="{Binding TopDoctorTitle}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            FontFamily="{StaticResource CurrentAppFont}"
                                            Margin="0,20,0,10"
                                            HorizontalAlignment="Center"/>

                                        <ListView Margin="10" ItemsSource="{Binding ReportSummary.TopDoctors}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding DoctorName}" Width="120"/>
                                                        <ProgressBar Value="{Binding PatientCount}" Width="150" Height="20"/>
                                                        <TextBlock Text="{Binding PatientCount}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>

                                    <!-- Add CHart for  top 3 doctors-->

                                    <StackPanel Grid.Row="1" Spacing="5" Width="400">
                                        <chart:SfCartesianChart Margin="5"
                                                                xmlns:chart="using:Syncfusion.UI.Xaml.Charts">
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:CategoryAxis x:Uid="Rpg_DoctorsAxis"
                                                                    Header="Doctors" FontWeight="Bold" />
                                            </chart:SfCartesianChart.XAxes>
                                            
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis x:Uid="Rpg_PatientsAxis"
                                                                     Header="Patients" Maximum="{Binding TotalPatientsCount}" FontWeight="SemiBold"/>
                                            </chart:SfCartesianChart.YAxes>

                                            <chart:ColumnSeries ItemsSource="{Binding ReportSummary.TopDoctors}"
                                                                XBindingPath="DoctorName"
                                                                YBindingPath="PatientCount"
                                                                ShowDataLabels="True"/>
                                        </chart:SfCartesianChart>


                                    </StackPanel>

                                </Grid>
                            </Border>


                            <!-- Top Specializations Section -->
                            <Border Padding="10" CornerRadius="10" Background="#FFccf5ff" Margin="10" Width="400">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="AUto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0">
                                        <TextBlock 
                                            Text="{Binding TopSpecializationsTitle}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            FontFamily="{StaticResource CurrentAppFont}"
                                            Margin="0,20,0,10"
                                            HorizontalAlignment="Center"/>

                                        <ListView Margin="10" ItemsSource="{Binding ReportSummary.TopSpecializations}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Specialization}" Width="120"/>
                                                        <ProgressBar Value="{Binding PatientCount}" Width="150" Height="20"/>
                                                        <TextBlock Text="{Binding PatientCount}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">

                                        <chart:SfCartesianChart Margin="10"
                                                                xmlns:chart="using:Syncfusion.UI.Xaml.Charts">
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:CategoryAxis x:Uid="Rpg_SpecializationsAxis"
                                                                    Header="Specializations" Margin="0,10,0,0" FontWeight="SemiBold" 
                                                                    FontFamily="{StaticResource CurrentAppFont}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis x:Uid="Rpg_PatientsAxisSpecializations"
                                                                     Header="Patients" Maximum="{Binding TopSpecializationsCount}" FontWeight="SemiBold" 
                                                                     FontFamily="{StaticResource CurrentAppFont}"/>
                                            </chart:SfCartesianChart.YAxes>

                                            <chart:ColumnSeries ItemsSource="{Binding ReportSummary.TopSpecializations}"
                                                                XBindingPath="Specialization"
                                                                YBindingPath="PatientCount"
                                                                ShowDataLabels="True">
                                            </chart:ColumnSeries>
                                        </chart:SfCartesianChart>

                                    </StackPanel>
                                    
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Right Column: Audit Summary -->

                <ScrollViewer Grid.Column="1" 
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Margin="10" Spacing="20">
                            <TextBlock x:Uid="Rpg_AuditSummary"
                                       Text="Audit Summary"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>

                            <!-- Roles Grid -->
                            <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <!-- Administrator -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#FF3B6EF5" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Administrator"
                                                   Text="Administrator" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.AdministratorCount }" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- HR -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#28a768" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_HR"
                                                   Text="HR" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.HRCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Moderator -->
                                <Border Grid.Row="0" Grid.Column="2" Background="#e19330" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Moderator"
                                                   Text="Moderator" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.ModeratorCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Doctor -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#FF5C4DFF" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_DoctorRole"
                                                   Text="Doctor" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.DoctorCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pharmacist -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#00a892" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Pharmacist"
                                                   Text="Pharmacist" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.PharmacistCount }" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Nurse -->
                                <Border Grid.Row="1" Grid.Column="2" Background="#FF9C4DCC" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Nurse"
                                                   Text="Nurse" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.NurseCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Receptionist -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#FF0000CC" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Receptionist"
                                                   Text="Receptionist" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.ReceptionistCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Guest -->
                                <Border Grid.Row="2" Grid.Column="1" Background="#FFDC3545" Width="120" Height="80" CornerRadius="8" Padding="10" Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Rpg_Guest"
                                                   Text="Guest" Foreground="White" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding ReportSummary.GuestCount}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Top Role Highlight -->
                            <Border Background="#FF6F4FFF" Padding="30" CornerRadius="10" Margin="10">
                                <StackPanel>
                                    <TextBlock x:Uid="Rpg_MostCommonRole"
                                               Text="Most Common Role" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
                                    <TextBlock Text="{Binding ReportSummary.MostCommonRole}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>


        </Grid>


        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text=""
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="Black"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>



    </Grid>
</Page>
