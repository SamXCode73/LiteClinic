<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:LiteClinic.ViewModels"  
    d:DataContext="{d:DesignInstance Type=viewmodels:SplashScreenViewModel, IsDesignTimeCreatable=True}"    
    mc:Ignorable="d"
    Background="#ececec">

    <!-- Pick ONE of these gradient backgrounds -->

    <!-- Right → Left -->
    <!--<Page.Background>
        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
            <GradientStop Color="Red" Offset="0.0"/>
            <GradientStop Color="LightBlue" Offset="0.5"/>
            <GradientStop Color="DarkBlue" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>-->

    <!-- Top → Bottom -->
    <!--<Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="DarkBlue" Offset="0.0"/>
            <GradientStop Color="LightBlue" Offset="0.5"/>
            <GradientStop Color="Red" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>-->

    <!-- Diagonal (Top‑Left → Bottom‑Right) -->

    <!--
    <Page.Background>
        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="Teal" Offset="0.15"/>

            <GradientStop Color="RoyalBlue" Offset="0.5"/>

            <GradientStop Color="Teal" Offset="0.85"/>
        </LinearGradientBrush>
    </Page.Background>
-->
    <Grid>
        <Border Width="1020" 
                Height="620" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="#FFFFFFFF">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Uid="WelcomeSpalshScreen"
                           FontFamily="{StaticResource CurrentAppFont}"
                           FontSize="38"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0, 25, 0, 10"
                           Foreground="DimGray"/>

                <!-- Application Logo Image -->

                <Grid Grid.Row="1" Margin="10" MaxWidth="500" MaxHeight="300" Background="Transparent">
                    <Image Source="/Assets/images/liteclinic.jpg" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Stretch="Fill"/>
                </Grid>

                <TextBlock Grid.Row="2" 
                           FontFamily="{StaticResource CurrentAppFontItalic}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="10"
                           x:Name="StatusMessage"
                           Foreground="{Binding StatusColor}"
                           Text="{Binding StatusMessage}"/>


                <TextBlock Grid.Row="3"
                           FontFamily="{StaticResource CurrentAppFontItalic}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="20"
                           x:Name="CopyrightLabel"
                           Foreground="DimGray"
                           Text="{Binding CopyRightText}"/>

            </Grid>
        </Border>
    </Grid>
</Page>