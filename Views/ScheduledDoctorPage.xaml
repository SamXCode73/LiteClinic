<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteClinic.Views.ScheduledDoctorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LiteClinic.Services"
    xmlns:viewmodels="using:LiteClinic.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ScheduledDoctorViewModel, IsDesignTimeCreatable=True}"    
    mc:Ignorable="d"
    Background="#f1f1f1">


    <Page.Resources>
        <Style x:Key="CustomColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>



        <services:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <services:BoolToBrushConverterForDoctors x:Key="BoolToBrushConverterForDoctors"/>
        <services:BoolToSizeConverter x:Key="BoolToSizeConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F1" Invoked="ScheduledPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="ScheduledPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F3" Invoked="ScheduledPageKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="ScheduledPageKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>

        <!-- Define two rows: main content and bottom info bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="40" />
            <!-- Info bar -->
        </Grid.RowDefinitions>


        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>
            <!-- Main Content-->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="10, 10, 5, 5">
                    <!-- Basic Info -->
                    <StackPanel>
                        <TextBlock x:Uid="SchDp_AddDoctorScheduled"
                                   Text="Add Doctor's Scheduled" 
                                   FontFamily="{StaticResource CurrentAppFont}" 
                                   FontWeight="Bold" Margin="0,10,0,10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ScheduleDoctorNameBox"
                                  ItemsSource="{Binding DoctorsListforScheduled}"
                                  SelectedValue="{Binding DoctorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="DoctorId"
                                  DisplayMemberPath="FullName"
                                  x:Uid="SchDp_ScheduleDoctorNameBox"
                                  Header="Choose doctor"
                                  Width="200">

                        </ComboBox>
                        <Ellipse Width="7" Height="7" Fill="#FFFF0000" Margin="10,25,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Uid="SchDp_ScheduleDayOfWeekBox"
                                  Header="Day of Week" Width="200"
                                  SelectedValue="{Binding DayOfTheWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                                  
                                  SelectedValuePath="Content">
                            
                            <ComboBoxItem x:Uid="SchDp_Monday" Content="Monday"/>
                            <ComboBoxItem x:Uid="SchDp_Tuesday" Content="Tuesday"/>
                            <ComboBoxItem x:Uid="SchDp_Wednesday" Content="Wednesday"/>
                            <ComboBoxItem x:Uid="SchDp_Thursday" Content="Thursday"/>
                            <ComboBoxItem x:Uid="SchDp_Friday" Content="Friday"/>
                            <ComboBoxItem x:Uid="SchDp_Saturday" Content="Saturday"/>
                        </ComboBox>
                        <Ellipse Width="7" Height="7" Fill="#FFFF0000" Margin="10,25,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TimePicker x:Uid="SchDp_TimePickerFrom" 
                                    Header="From:"
                                    ClockIdentifier="12HourClock"
                                    MinuteIncrement="15"
                                    SelectedTime="{Binding DisTimeFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TimePicker x:Uid="SchDp_TimePickerTo" 
                                    Header="To:" 
                                    ClockIdentifier="12HourClock"
                                    MinuteIncrement="15"
                                    SelectedTime="{Binding DisTimeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>
                    <StackPanel>

                    </StackPanel>

                    <StackPanel>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Uid="SchDp_Week1"
                                          Content="Week 1" 
                                          IsChecked="{Binding IsWeek1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Ellipse 
                                Width="{Binding IsWeek1,Converter={StaticResource BoolToSizeConverter}}"
                                Height="{Binding IsWeek1,Converter={StaticResource BoolToSizeConverter}}" 
                                Fill="{Binding IsWeek1,Converter={StaticResource BoolToBrushConverterForDoctors}}" 
                                    Margin="50,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Uid="SchDp_Week2"
                                          Content="Week 2" 
                                          IsChecked="{Binding IsWeek2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Ellipse 
                                Width="{Binding IsWeek2,Converter={StaticResource BoolToSizeConverter}}"
                                Height="{Binding IsWeek2,Converter={StaticResource BoolToSizeConverter}}" 
                                Fill="{Binding IsWeek2,Converter={StaticResource BoolToBrushConverterForDoctors}}" 
                                    Margin="50,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Uid="SchDp_Week3"
                                          Content="Week 3" 
                                          IsChecked="{Binding IsWeek3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Ellipse 
                                Width="{Binding IsWeek3,Converter={StaticResource BoolToSizeConverter}}"
                                Height="{Binding IsWeek3,Converter={StaticResource BoolToSizeConverter}}" 
                                Fill="{Binding IsWeek3,Converter={StaticResource BoolToBrushConverterForDoctors}}" 
                                    Margin="50,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Uid="SchDp_Week4"
                                          Content="Week 4" 
                                          IsChecked="{Binding IsWeek4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Ellipse 
                                Width="{Binding IsWeek4,Converter={StaticResource BoolToSizeConverter}}"
                                Height="{Binding IsWeek4,Converter={StaticResource BoolToSizeConverter}}" 
                                Fill="{Binding IsWeek4,Converter={StaticResource BoolToBrushConverterForDoctors}}" 
                                    Margin="50,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Uid="SchDp_Week5"
                                          Content="Week 5 (if available)" 
                                          IsChecked="{Binding IsWeek5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Ellipse x:Uid="SchDp_Week5Ellipse"
                                         Width="{Binding IsWeek5,Converter={StaticResource BoolToSizeConverter}}"
                                         Height="{Binding IsWeek5,Converter={StaticResource BoolToSizeConverter}}" 
                                         Fill="{Binding IsWeek5,Converter={StaticResource BoolToBrushConverterForDoctors}}" />
                            </StackPanel>

                        </StackPanel>

                        <Border Background="LightGray" 
                                BorderBrush="#FFBF00"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="10"
                                Width="250"
                                Height="Auto">
                            <TextBlock x:Uid="SchDp_Week5Note"
                                       Text="Week 5 notifications are only sent if selected and the month contains a fifth weekday.To avoid conflicts where notifications may not be sent in week 5, please always check week 5 if available."
                                       Foreground="Black"
                                       TextWrapping="Wrap"
                                       Margin="1"
                                       FontFamily="{StaticResource CurrentAppFontItalic}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Uid="SchDp_NotifyClinic"
                                      Content="Notify for Clinic" 
                                      Margin="0,2" 
                                      IsChecked="{Binding CanNotify, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Ellipse Width="7" Height="7" Fill="#FFFF0000" Margin="20,0,0,0"/>
                        </StackPanel>


                    </StackPanel>

                    <StackPanel>
                        <CheckBox x:Uid="SchDp_IsActive"
                                  Content="Is Active" 
                                  Margin="0,2" 
                                  IsChecked="{Binding IsScheduleActiveDis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <!-- Submit.Edite Button -->
                        <Button x:Uid="SchDp_AddButton"
                                Content="Add"  
                                Margin="10" 
                                Background="Teal" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanAddDoctorScheduled}"
                                Command="{Binding Btn_SaveDcotorScheduledCommand}"/>
                        <Button x:Uid="SchDp_EditButton"
                                Content="Edit"  
                                Margin="10" 
                                Background="RoyalBlue" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanEditDoctorScheduled}"
                                Command="{Binding Btn_UpdateDcotorScheduledCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        
                        <!-- Deactivate Button -->
                        <Button x:Uid="SchDp_DeactivateButton"
                                Content="Deactivate" 
                                Margin="10" 
                                Background="Red" 
                                Foreground="White" 
                                Width="90"
                                IsEnabled="{Binding CanDeactivateDoctorScheduled}"
                                Command="{Binding Btn_DeactivateDoctorScheduledCommadn}"/>
                        
                        <!-- Deactivate Button -->
                        <Button x:Uid="SchDp_ClearButton"
                                Content="Clear"  
                                Margin="10" 
                                Background="LightGray" 
                                Foreground="Black" 
                                Width="90"
                                Command="{Binding Btn_ClearCommand}"/>
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Border Width="1" Background="Gray" Margin="5"/>

            </StackPanel>
            <!-- Title and Data Grid -->
            <!-- Title -->
            <Grid Column="1" HorizontalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Uid="SchDp_DoctorsManagerListTextBlock"
                               Text="Doctors Manager List"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource CurrentAppFont}"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="15, 30, 5, 10"/>

                    <TextBox Grid.Column="1"
                             x:Uid="SchDp_ScheduleSearchBox"
                             PlaceholderText="Search"
                             Width="250"
                             HorizontalAlignment="Center"
                             Margin="10, 30, 10, 30"                             
                             Height="10"
                             Text="{Binding ScheduleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource CurrentAppFont}"
                             FontWeight="Bold"/>
                    
                    <!-- Back To doctro's Page Button-->
                    <Button Grid.Column="2" 
                            x:Uid="SchDp_BackButton"
                            Content="Back to Doctor's Page"
                            Margin="5, 20, 20, 5"
                            Background="RoyalBlue"
                            Foreground="White" 
                            HorizontalAlignment="Right"
                            Click="Button_Click_BackToDoctorPage"
                            FontFamily="{StaticResource CurrentAppFont}"
                            FontWeight="Bold"/>

                </Grid>

            <!-- Doctor List View -->
                <ListView x:Name="ListViewSchedule"
                          Grid.Row="1"
                          Margin="15"
                          Padding="10"
                          SelectionMode="Single"
                          ItemsSource="{Binding ScheduledDisplayList}"
                          SelectedItem="{Binding SelectedScheduledDisplay, Mode=TwoWay}"
                          DoubleTapped="ListView_DoubleTapped"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Left">

                    <!-- Column headers -->
                    <ListView.Header>
                        <Grid ColumnDefinitions="120,220,220,150,150,150,150,150,120,120"
                              Background="LightGray" Height="30">
                            <TextBlock Text="Doctor's ID" Grid.Column="0" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Doctor's Name" Grid.Column="1" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Day of the Week" Grid.Column="2" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Day Of the Week" Grid.Column="3" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Time" Grid.Column="4" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Weeks of Month" Grid.Column="5" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Mobile Phone" Grid.Column="6" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Notify" Grid.Column="7" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Active" Grid.Column="8" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Auto" Grid.Column="9" Style="{StaticResource CustomColumnHeaderStyle}"/>
                            <TextBlock Text="Schdled Id" Grid.Column="10" Style="{StaticResource CustomColumnHeaderStyle}"/>
                        </Grid>
                    </ListView.Header>

                    <!-- Row template -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="120,220,220,150,150,150,150,150,120,120,120" Height="40">
                                <!-- Doctor's ID -->
                                <TextBlock Text="{Binding DoctorIdDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="0" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Doctor's Name -->
                                <TextBlock Text="{Binding FullNameDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="1" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Specialization / Day of the Week -->
                                <TextBlock Text="{Binding SpecializationDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="2" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Day Of the Week -->
                                <TextBlock Text="{Binding DayOfWeekDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="3" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Time -->
                                <TextBlock Text="{Binding TimeDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="4" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Weeks of Month -->
                                <TextBlock Text="{Binding WeekNumbersDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="5" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Mobile Phone -->
                                <TextBlock Text="{Binding PhoneNumberDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="6" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Notify -->
                                <CheckBox IsChecked="{Binding NotifyDis, Mode=TwoWay}"
                                          Content="Active"
                                          Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                          HorizontalAlignment="Center"
                                          Margin="20,0,0,0"
                                          Grid.Column="7"/>

                                <!-- Active -->
                                <CheckBox IsChecked="{Binding IsScheduleActiveDis, Mode=TwoWay}"
                                          Content="Active"
                                          Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                          HorizontalAlignment="Center"
                                          Margin="20,0,0,0"
                                          Grid.Column="8"/>

                                <!-- Auto -->
                                <TextBlock Text="{Binding ScheduleAutoIdDis}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="9" Style="{StaticResource CustomCellStyle}"/>

                                <!-- Scheduled Id -->
                                <TextBlock Text="{Binding ScheduleIdDis, Mode=TwoWay}"
                                           Foreground="{Binding IsScheduleActiveDis, Converter={StaticResource BoolToBrushConverter}}"
                                           Grid.Column="10" Style="{StaticResource CustomCellStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>


                <ScrollViewer Grid.Row="2"  HorizontalScrollBarVisibility="Auto" Margin="15"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled">
                    <Grid Margin="3" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="30">
                            <!-- Add -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FF008080" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_AddLegend" Text="Add = F1" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Edit -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FF4169E1" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_EditLegend" Text="Edit = F2" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Deactivate -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FFFF0000" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_DeactivateLegend" Text="Deactivate = F3" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Clear -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FFD3D3D3" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_ClearLegend" Text="Clear = F4" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Deactivate Row Color -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="16" Fill="#FFCD5C5C" Stroke="#FF808080" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_DeactivatedUserLegend" Text="Deactivated User" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30" Margin="15">
                            <!-- Add somthign if you want -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Add you code here -->
                                <Ellipse Width="14" Height="14" Fill="#FFFF0000" Stroke="Gray" Margin="0,0,5,0"/>
                                <TextBlock x:Uid="SchDp_RequiredFieldsNote" Text="Required fields are marked with a red circle" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- Info bar -->
        <Border Grid.Row="1"
        Background="#dcdcdc"
        Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left-aligned Roman date -->
                <TextBlock Text="{Binding RomanDate}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource InfoTextBottomBar}"
                           Foreground="Gray"
                           x:Name="RomanDateText"
                           Visibility="{Binding GregorianDateVisibility}"/>

                <!-- Centered system status -->
                <TextBlock Text="{Binding StatusMessageSch}"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockFontItalic}"
                           Foreground="{Binding StatusColor}"
                           x:Name="StatusInfoText"/>

                <!-- Right-aligned Hijri date -->
                <TextBlock Text="{Binding HijriDate}"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource ArabicFont}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="Gray"
                           x:Name="HijriDateText"
                           Visibility="{Binding HijriDateVisibility}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
