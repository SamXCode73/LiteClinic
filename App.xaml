<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LiteClinic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteClinic" xmlns:services="using:LiteClinic.Services">
    
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Global resources go here -->

            <ResourceDictionary.ThemeDictionaries>

                <!-- Light Theme -->
                <ResourceDictionary x:Key="Light">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1C2A3A" Offset="0.0"/>
                        <!-- Darker top-left -->
                        <GradientStop Color="#FF2F3E4D" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FF465564" Offset="1.0"/>
                        <!-- Lighter bottom-right -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF2F3E4D" Offset="0.0"/>
                        <!-- Darker top -->
                        <GradientStop Color="#FF3F4E5D" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FF5F6E7D" Offset="1.0"/>
                        <!-- Lighter bottom -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#90CAF9"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#64B5F6"/>
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#42A5F5"/>
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#EEE" />
                    <SolidColorBrush x:Key="TextBrush" Color="#333" />                    
                </ResourceDictionary>

                <!-- Dark Theme -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF121212" Offset="0.0"/>
                        <!-- Darker top-left -->
                        <GradientStop Color="#FF1E1E1E" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FF2A2A2A" Offset="1.0"/>
                        <!-- Lighter bottom-right -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF2E2E2E" Offset="0.0"/>
                        <!-- Slightly lighter top -->
                        <GradientStop Color="#FF3C3C3C" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FF4A4A4A" Offset="1.0"/>
                        <!-- Lighter bottom -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FFCCCCCC"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FF444444"/>
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF666666"/>
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#333" />
                    <SolidColorBrush x:Key="TextBrush" Color="#EEE" />                    
                </ResourceDictionary>

                <!-- Pink Theme -->
                <ResourceDictionary x:Key="Pink">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFCC5A9E" Offset="0.0"/>
                        <!-- Slightly darker pink (top-left) -->
                        <GradientStop Color="#FFFF69B4" Offset="0.5"/>
                        <!-- Base HotPink (mid) -->
                        <GradientStop Color="#FFFF85C1" Offset="1.0"/>
                        <!-- Softer light pink (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFF85C1" Offset="0.0"/>
                        <!-- LightPink (top) -->
                        <GradientStop Color="#FFFFB6C1" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FFFFC6CC" Offset="1.0"/>
                        <!-- Very soft pink (bottom) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FFDB7093"/>
                    <!-- PaleVioletRed -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FFB03060"/>
                    <!-- DeepRose -->
                </ResourceDictionary>


                <!-- RoyalBlue Theme -->
                <ResourceDictionary x:Key="RoyalBlue">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF3559E6" Offset="0.0"/>
                        <!-- Slightly darker royal blue (top-left) -->
                        <GradientStop Color="#FF4169FF" Offset="0.5"/>
                        <!-- Base RoyalBlue (mid) -->
                        <GradientStop Color="#FF5A7FFF" Offset="1.0"/>
                        <!-- Softer lighter blue (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF649BED" Offset="0.0"/>
                        <!-- CornflowerBlue (top) -->
                        <GradientStop Color="#FF739FEF" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FF88AEF2" Offset="1.0"/>
                        <!-- Lighter bottom -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FF87CEFA"/>
                    <!-- LightSkyBlue -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF4682B4"/>
                    <!-- SteelBlue -->
                </ResourceDictionary>

                <!-- Teal Theme -->
                <ResourceDictionary x:Key="Teal">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF006666" Offset="0.0"/>
                        <!-- Slightly darker teal (top-left) -->
                        <GradientStop Color="#FF008080" Offset="0.5"/>
                        <!-- Base teal (mid) -->
                        <GradientStop Color="#FF339999" Offset="1.0"/>
                        <!-- Softer lighter teal (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF4A7F7F" Offset="0.0"/>
                        <!-- Slightly lighter dark teal (top) -->
                        <GradientStop Color="#FF5F9A9A" Offset="0.5"/>
                        <!-- Mid teal -->
                        <GradientStop Color="#FF75ADAD" Offset="1.0"/>
                        <!-- Softer teal (bottom) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FF20B2AA"/>
                    <!-- LightSeaGreen -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF008B8B"/>
                    <!-- DarkCyan -->
                </ResourceDictionary>

                <!-- Violet Theme -->
                <ResourceDictionary x:Key="Violet">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF7A00B3" Offset="0.0"/>
                        <!-- Darker violet (top-left) -->
                        <GradientStop Color="#FF9400D3" Offset="0.5"/>
                        <!-- Base violet (mid) -->
                        <GradientStop Color="#FFA64DDA" Offset="1.0"/>
                        <!-- Softer lighter violet (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFAFA0C6" Offset="0.0"/>
                        <!-- Keep same darker lavender (top) -->
                        <GradientStop Color="#FFC6BFE0" Offset="0.5"/>
                        <!-- Mid tone, ~15% lighter -->
                        <GradientStop Color="#FFD2CCE6" Offset="1.0"/>
                        <!-- Softer violet (bottom, ~15% lighter) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FFBA55D3"/>
                    <!-- MediumOrchid -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF9932CC"/>
                    <!-- DarkOrchid -->
                </ResourceDictionary>

                <!-- MintGreen Theme -->
                <ResourceDictionary x:Key="MintGreen">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF70CC70" Offset="0.0"/>
                        <!-- Darker mint (top-left) -->
                        <GradientStop Color="#FF98FF98" Offset="0.5"/>
                        <!-- Base mint green (mid) -->
                        <GradientStop Color="#FFB2FFB2" Offset="1.0"/>
                        <!-- Softer lighter mint (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF9ECC9E" Offset="0.0"/>
                        <!-- Light mint (top, 20% darker) -->
                        <GradientStop Color="#FFB9DCB9" Offset="0.5"/>
                        <!-- Mid tone, 15% darker -->
                        <GradientStop Color="#FFC2DCC2" Offset="1.0"/>
                        <!-- Very soft mint (bottom, 15% darker) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FF90EE90"/>
                    <!-- LightGreen -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF32CD32"/>
                    <!-- LimeGreen -->
                </ResourceDictionary>

                <!-- Coral Theme -->
                <ResourceDictionary x:Key="Coral">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFE5533A" Offset="0.0"/>
                        <!-- Darker coral (top-left) -->
                        <GradientStop Color="#FFFF6347" Offset="0.5"/>
                        <!-- Base coral (mid) -->
                        <GradientStop Color="#FFFF7F66" Offset="1.0"/>
                        <!-- Softer lighter coral (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFB38C" Offset="0.0"/>
                        <!-- Light coral/peach (top) -->
                        <GradientStop Color="#FFFFC2A3" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FFFFD1BA" Offset="1.0"/>
                        <!-- Very soft peach (bottom) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FFFFA07A"/>
                    <!-- LightSalmon -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FFFF6347"/>
                    <!-- Tomato -->
                </ResourceDictionary>

                <!-- Lavender Theme -->
                <ResourceDictionary x:Key="Lavender">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF7E66A0" Offset="0.0"/>
                        <!-- Darker lavender (top-left) -->
                        <GradientStop Color="#FF967BB6" Offset="0.5"/>
                        <!-- Base lavender (mid) -->
                        <GradientStop Color="#FFB29FD0" Offset="1.0"/>
                        <!-- Softer lighter lavender (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFB8B8C8" Offset="0.0"/>
                        <!-- Lavender top, 20% darker -->
                        <GradientStop Color="#FFC9C9D5" Offset="0.5"/>
                        <!-- Mid tone, 15% darker -->
                        <GradientStop Color="#FFD1D1E9" Offset="1.0"/>
                        <!-- Very soft lavender bottom, 15% darker -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FFD8BFD8"/>
                    <!-- Thistle -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF9370DB"/>
                    <!-- MediumPurple -->
                </ResourceDictionary>

                <!-- Sandstone Theme -->
                <ResourceDictionary x:Key="Sandstone">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFA89060" Offset="0.0"/>
                        <!-- Darker sandstone (top-left) -->
                        <GradientStop Color="#FFC2B280" Offset="0.5"/>
                        <!-- Base sandstone (mid) -->
                        <GradientStop Color="#FFD6C89A" Offset="1.0"/>
                        <!-- Softer lighter sandstone (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFDECAA0" Offset="0.0"/>
                        <!-- Light sandy beige (top) -->
                        <GradientStop Color="#FFE6D5B3" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FFEEE0C6" Offset="1.0"/>
                        <!-- Very soft sandstone (bottom) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FFD2B48C"/>
                    <!-- Tan -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FFCD853F"/>
                    <!-- Peru -->
                </ResourceDictionary>

                <!-- Monochrome Theme -->
                <ResourceDictionary x:Key="Monochrome">
                    <!-- Gradient Top Bar Background -->
                    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF303030" Offset="0.0"/>
                        <!-- Darker gray (top-left) -->
                        <GradientStop Color="#FF404040" Offset="0.5"/>
                        <!-- Base gray (mid) -->
                        <GradientStop Color="#FF505050" Offset="1.0"/>
                        <!-- Lighter gray (bottom-right) -->
                    </LinearGradientBrush>

                    <!-- Gradient Sidebar Background -->
                    <LinearGradientBrush x:Key="SideBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFC8C8C8" Offset="0.0"/>
                        <!-- Light gray (top) -->
                        <GradientStop Color="#FFD8D8D8" Offset="0.5"/>
                        <!-- Mid tone -->
                        <GradientStop Color="#FFE8E8E8" Offset="1.0"/>
                        <!-- Very soft gray (bottom) -->
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="TopBarForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="MenuLabelForegroundBrush" Color="#FF000033"/>
                    <SolidColorBrush x:Key="MenuLabelPointerOverBrush" Color="#FF808080"/>
                    <!-- Gray -->
                    <SolidColorBrush x:Key="MenuLabelPressedBrush" Color="#FF505050"/>
                    <!-- DimGray -->
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <services:ThemeTypeToColorConverter x:Key="ThemeTypeToColorConverter"/>


            <!-- Font Definitions -->
            <FontFamily x:Key="EnglishFont">Segoe UI, Arial, Times New Roman</FontFamily>
            <FontFamily x:Key="ArabicFont">Calibri, Segoe UI, Segoe UI Historic, Arial, Times New Roman</FontFamily>
            <FontFamily x:Key="CurrentAppFont">Calibri, Arial, Segoe UI, Segoe UI Historic, Times New Roman</FontFamily>
            <FontFamily x:Key="CurrentAppFont2">Arial, Segoe UI, Segoe UI Historic, Times New Roman, Calibri</FontFamily>
            <FontFamily x:Key="CurrentAppFontItalic">Segoe UI</FontFamily>
            <FontFamily x:Key="CurrentStyleAppFont">Trbucher MS</FontFamily>

            <x:Double x:Key="RadioButtonCheckGlyphSize">20</x:Double>
            <x:Double x:Key="RadioButtonCheckGlyphStrokeThickness">2</x:Double>
            <x:Double x:Key="RadioButtonCheckGlyphStrokeThicknessWhenChecked">2</x:Double>

            <!-- Top Menu -->

            <Style x:Key="TopMenuTextMain" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
                <Setter Property="FontSize" Value="22" />
            </Style>

            <Style x:Key="TopMenuTextSub" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="MyMenuTextStyleNormal" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="TextBlockFont" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="TextBlockFontItalic" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>                
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="InfoTextBottomBar" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CurrentAppFontItalic}" />
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="TextBlockDateAr" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="RadioButtonFont" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource EnglishFont}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="CheckBoxFont" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource EnglishFont}" />
                <Setter Property="FontSize" Value="14" />
            </Style>


            <!-- Other app resources here -->
        </ResourceDictionary>

    </Application.Resources>

</Application>
